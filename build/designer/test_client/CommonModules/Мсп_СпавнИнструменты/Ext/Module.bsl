// MCP-tools system_spawn_1c_client / system_kill_pid (перенос из Rust addin.spawn/addin.kill).
// ADR — docs/decisions/0003-spawn-tools-in-test-client.md.
// Парный ADR в web-transport-addin/docs/decisions/0005-transport-only-rust.md.

#Область ПрограммныйИнтерфейс

// Регистрирует системные tools spawn/kill в реестре MCP.
Процедура Зарегистрировать(ИсточникРегистрации) Экспорт

	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"system_spawn_1c_client",
		"Запускает дочерний 1С-клиент с параметрами от менеджера. PID не возвращается — менеджер сопоставляет ребёнка по последующему session.register с тем же client_uid.",
		СхемаВходныхПараметровSpawn(),
		Новый ОписаниеОповещения("ОбработчикSpawn", Мсп_СпавнИнструменты)),
		ИсточникРегистрации);

	Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
		"system_kill_pid",
		"Принудительно завершает процесс по PID. Fallback для зомби-клиентов, не отвечающих на session.shutdown.",
		СхемаВходныхПараметровKill(),
		Новый ОписаниеОповещения("ОбработчикKill", Мсп_СпавнИнструменты)),
		ИсточникРегистрации);

КонецПроцедуры

// Обработчик system_spawn_1c_client.
//
// Параметры:
//  Запрос - Структура - см. идиому Мсп_ИнструментТестКлиент.
//  ДополнительныеПараметры - Произвольный.
//
// Возвращаемое значение:
//  Структура - Результат через Мсп_Результаты.JSON.
Функция ОбработчикSpawn(Запрос, ДополнительныеПараметры) Экспорт
	Аргументы = Запрос.Аргументы;

	Валидация = Мсп_СпавнВалидатор.ВалидироватьSpawnАргументы(Аргументы);
	Если Не Валидация.Успех Тогда
		Возврат НовыйРезультатИнструмента(
			Ложь,
			Неопределено,
			Валидация.КодОшибки,
			СтрСоединить(Валидация.Ошибки, "; "));
	КонецЕсли;

	КомандаЗапуска = СобратьКомандуСпавна(Аргументы);
	Если Не КомандаЗапуска.Успех Тогда
		Возврат НовыйРезультатИнструмента(Ложь, Неопределено, КомандаЗапуска.КодОшибки, КомандаЗапуска.Ошибка);
	КонецЕсли;

	Мсп_ЛогированиеКлиент.Информация(
		"system_spawn_1c_client: client_uid=%1 kind=%2",
		Мсп_Коллекции.Свойство(Аргументы, "client_uid"),
		Мсп_Коллекции.Свойство(Аргументы, "kind"));

	Попытка
		ЗапуститьПриложение(КомандаЗапуска.Команда, , Ложь);
	Исключение
		Мсп_ЛогированиеКлиент.Ошибка(
			"system_spawn_1c_client: spawn failed: %1",
			ПодробноеПредставлениеОшибки());
		Возврат НовыйРезультатИнструмента(
			Ложь,
			Неопределено,
			"spawn_failed",
			ПодробноеПредставлениеОшибки());
	КонецПопытки;

	Данные = Новый Структура;
	Данные.Вставить("client_uid", Мсп_Коллекции.Свойство(Аргументы, "client_uid"));
	Данные.Вставить("command_line_preview", МаскироватьПароль(КомандаЗапуска.Команда));

	Возврат НовыйРезультатИнструмента(Истина, Данные);
КонецФункции

// Обработчик system_kill_pid.
Функция ОбработчикKill(Запрос, ДополнительныеПараметры) Экспорт
	Аргументы = Запрос.Аргументы;

	Валидация = Мсп_СпавнВалидатор.ВалидироватьKillАргументы(Аргументы);
	Если Не Валидация.Успех Тогда
		Возврат НовыйРезультатИнструмента(
			Ложь,
			Неопределено,
			Валидация.КодОшибки,
			СтрСоединить(Валидация.Ошибки, "; "));
	КонецЕсли;

	PID = Мсп_Коллекции.Свойство(Аргументы, "pid");
	Сигнал = Мсп_Коллекции.Свойство(Аргументы, "signal", "term");

	Если Не ПроцессСуществует(PID) Тогда
		Возврат НовыйРезультатИнструмента(
			Ложь,
			Неопределено,
			"pid_not_found",
			СтрШаблон("PID %1 does not exist", PID));
	КонецЕсли;

	КомандаKill = СобратьКомандуKill(PID, Сигнал);

	Мсп_ЛогированиеКлиент.Информация(
		"system_kill_pid: pid=%1 signal=%2",
		PID, Сигнал);

	Попытка
		ЗапуститьПриложение(КомандаKill, , Истина);
	Исключение
		Мсп_ЛогированиеКлиент.Ошибка(
			"system_kill_pid: kill failed: %1",
			ПодробноеПредставлениеОшибки());
		Возврат НовыйРезультатИнструмента(
			Ложь,
			Неопределено,
			"kill_failed",
			ПодробноеПредставлениеОшибки());
	КонецПопытки;

	Данные = Новый Структура;
	Данные.Вставить("pid", PID);
	Данные.Вставить("signal", Сигнал);

	Возврат НовыйРезультатИнструмента(Истина, Данные);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область СхемыПараметров

Функция СхемаВходныхПараметровSpawn()
	Свойства = Новый Структура;
	Свойства.Вставить("binary",
		Мсп_СхемаПараметров.НовыйСвойствоСхемыСEnum("string",
			"Имя бинаря 1С (1cv8, 1cv8c, auto). По умолчанию auto = 1cv8c.",
			ДопустимыеБинари()));
	Свойства.Вставить("kind",
		Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
			"Тип роли клиента (test_client, vanessa_manager, yaxunit_runner, …). [A-Za-z0-9_-]{1,32}."));
	Свойства.Вставить("client_uid",
		Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
			"UUID, который менеджер ожидает в session.register от ребёнка. [0-9a-fA-F-]{36}."));
	Свойства.Вставить("corr_id",
		Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
			"Корреляционный идентификатор операции. [A-Za-z0-9_-]{1,64}."));
	Свойства.Вставить("manager_url",
		Мсп_СхемаПараметров.НовыйСвойствоСхемы("string",
			"URL менеджера сессий, передаётся ребёнку через /C manager_url=…"));
	Свойства.Вставить("language",
		Мсп_СхемаПараметров.НовыйСвойствоСхемыСEnum("string",
			"Язык интерфейса дочернего клиента", ДопустимыеЯзыки()));
	Свойства.Вставить("ib",
		Мсп_СхемаПараметров.НовыйСвойствоСхемы("object",
			"Параметры подключения к ИБ: {server: '..\\..', user, password}"));
	Свойства.Вставить("extra_c_args",
		Мсп_СхемаПараметров.НовыйСвойствоСхемы("object",
			"Дополнительные значения для /C: {mcpMode, mcp_ws_timeout_ms}"));

	ТребуемыеПоля = Новый Массив;
	ТребуемыеПоля.Добавить("kind");
	ТребуемыеПоля.Добавить("client_uid");

	Возврат Мсп_СхемаПараметров.НовыйСхемаОбъекта(Свойства, ТребуемыеПоля);
КонецФункции

Функция СхемаВходныхПараметровKill()
	Свойства = Новый Структура;
	Свойства.Вставить("pid",
		Мсп_СхемаПараметров.НовыйСвойствоСхемы("number",
			"PID процесса для завершения. Целое число >= 2 (PID 1 запрещён)."));
	Свойства.Вставить("signal",
		Мсп_СхемаПараметров.НовыйСвойствоСхемыСEnum("string",
			"Сигнал: term (мягко) или kill (жёстко). По умолчанию term.",
			ДопустимыеСигналы()));

	ТребуемыеПоля = Новый Массив;
	ТребуемыеПоля.Добавить("pid");

	Возврат Мсп_СхемаПараметров.НовыйСхемаОбъекта(Свойства, ТребуемыеПоля);
КонецФункции

Функция ДопустимыеБинари()
	Список = Новый Массив;
	Список.Добавить("1cv8");
	Список.Добавить("1cv8c");
	Список.Добавить("auto");
	Возврат Список;
КонецФункции

Функция ДопустимыеЯзыки()
	Список = Новый Массив;
	Список.Добавить("ru");
	Список.Добавить("en");
	Список.Добавить("tr");
	Возврат Список;
КонецФункции

Функция ДопустимыеСигналы()
	Список = Новый Массив;
	Список.Добавить("term");
	Список.Добавить("kill");
	Возврат Список;
КонецФункции

#КонецОбласти

#Область СборкаКоманды

Функция СобратьКомандуСпавна(Аргументы)
	Результат = Новый Структура("Успех, Команда, КодОшибки, Ошибка", Истина, "", "", "");

	БинарьЛогический = Мсп_Коллекции.Свойство(Аргументы, "binary", "auto");
	ПутьКПрограмме = РазрешитьПутьКБинарю(БинарьЛогический);
	Если Не ЗначениеЗаполнено(ПутьКПрограмме) Тогда
		Результат.Успех = Ложь;
		Результат.КодОшибки = "binary_not_found";
		Результат.Ошибка = СтрШаблон("Cannot resolve binary '%1' on this host", БинарьЛогический);
		Возврат Результат;
	КонецЕсли;

	Команда = ПутьКПрограмме + " ENTERPRISE";

	IB = Мсп_Коллекции.Свойство(Аргументы, "ib");
	Если IB <> Неопределено Тогда
		Команда = Команда + " /S""" + Мсп_Коллекции.Свойство(IB, "server", "") + """";
		Команда = Команда + " /N""" + Мсп_Коллекции.Свойство(IB, "user", "") + """";
		Пароль = Мсп_Коллекции.Свойство(IB, "password", "");
		Если ЗначениеЗаполнено(Пароль) Тогда
			Команда = Команда + " /P""" + Пароль + """";
		КонецЕсли;
	КонецЕсли;

	Команда = Команда + " /C""" + СобратьCСтроку(Аргументы) + """";

	Язык = Мсп_Коллекции.Свойство(Аргументы, "language", "");
	Если ЗначениеЗаполнено(Язык) Тогда
		Команда = Команда + " /L" + Язык;
	КонецЕсли;

	Команда = Команда + " /DisableStartupMessages /DisableStartupDialogs";

	Результат.Команда = Команда;
	Возврат Результат;
КонецФункции

Функция СобратьCСтроку(Аргументы)
	// /C-строка собирается через `;`-разделитель — формат, согласованный с
	// Мсп_ПараметрыЗапускаКлиент.ИзвлечьПараметрыWS (см. парный feedback в memory).
	Части = Новый Массив;

	Kind = Мсп_Коллекции.Свойство(Аргументы, "kind", "");
	ClientUID = Мсп_Коллекции.Свойство(Аргументы, "client_uid", "");
	Части.Добавить(СтрШаблон("kind=%1", Kind));
	Части.Добавить(СтрШаблон("client_uid=%1", ClientUID));

	CorrID = Мсп_Коллекции.Свойство(Аргументы, "corr_id", "");
	Если ЗначениеЗаполнено(CorrID) Тогда
		Части.Добавить(СтрШаблон("corr_id=%1", CorrID));
	КонецЕсли;

	ManagerURL = Мсп_Коллекции.Свойство(Аргументы, "manager_url", "");
	Если ЗначениеЗаполнено(ManagerURL) Тогда
		Части.Добавить(СтрШаблон("manager_url=%1", ManagerURL));
	КонецЕсли;

	ExtraC = Мсп_Коллекции.Свойство(Аргументы, "extra_c_args");
	Если ExtraC <> Неопределено Тогда
		MCPMode = Мсп_Коллекции.Свойство(ExtraC, "mcpMode", "");
		Если ЗначениеЗаполнено(MCPMode) Тогда
			Части.Добавить(СтрШаблон("mcpMode=%1", MCPMode));
		КонецЕсли;
		Таймаут = Мсп_Коллекции.Свойство(ExtraC, "mcp_ws_timeout_ms");
		Если Таймаут <> Неопределено Тогда
			Части.Добавить(СтрШаблон("mcp_ws_timeout_ms=%1", Формат(Таймаут, "ЧГ=0;")));
		КонецЕсли;
	КонецЕсли;

	Возврат СтрСоединить(Части, ";");
КонецФункции

Функция СобратьКомандуKill(PID, Сигнал)
	Если ЭтоWindows() Тогда
		Если Сигнал = "kill" Тогда
			Возврат СтрШаблон("taskkill /PID %1 /F", Формат(PID, "ЧГ=0;"));
		КонецЕсли;
		Возврат СтрШаблон("taskkill /PID %1", Формат(PID, "ЧГ=0;"));
	КонецЕсли;

	Если Сигнал = "kill" Тогда
		Возврат СтрШаблон("kill -KILL %1", Формат(PID, "ЧГ=0;"));
	КонецЕсли;
	Возврат СтрШаблон("kill -TERM %1", Формат(PID, "ЧГ=0;"));
КонецФункции

Функция РазрешитьПутьКБинарю(БинарьЛогический)
	КаталогПлатформы = КаталогПрограммы();
	Если Не ЗначениеЗаполнено(КаталогПлатформы) Тогда
		Возврат "";
	КонецЕсли;

	Если БинарьЛогический = "auto" Или Не ЗначениеЗаполнено(БинарьЛогический) Тогда
		ИмяБинаря = "1cv8c";
	Иначе
		ИмяБинаря = БинарьЛогический;
	КонецЕсли;

	Если ЭтоWindows() Тогда
		ИмяБинаря = ИмяБинаря + ".exe";
	КонецЕсли;

	Путь = КаталогПлатформы + ИмяБинаря;

	// Заворачиваем в кавычки, если содержит пробел (типичный Windows-кейс).
	Если СтрНайти(Путь, " ") > 0 Тогда
		Путь = """" + Путь + """";
	КонецЕсли;

	Возврат Путь;
КонецФункции

#КонецОбласти

#Область ПлатформенныеПроцедуры

Функция ЭтоWindows()
	// Эвристика по `КаталогПрограммы()` — Windows возвращает `C:\...\`,
	// Linux — `/opt/1cv8/...`. Без зависимости от `СистемнаяИнформация`.
	Каталог = КаталогПрограммы();
	Если Не ЗначениеЗаполнено(Каталог) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Лев(Каталог, 1) <> "/";
КонецФункции

Функция ПроцессСуществует(PID)
	КодВозврата = 0;
	Если ЭтоWindows() Тогда
		// `tasklist` сам по себе exit code не использует — нужен findstr.
		// `cmd /C "tasklist /FI \"PID eq N\" /NH | findstr <pid>"` → exit 0 если найдено, 1 иначе.
		Команда = СтрШаблон("cmd /C ""tasklist /FI ""PID eq %1"" /NH | findstr %1""",
			Формат(PID, "ЧГ=0;"));
	Иначе
		// `kill -0 PID` → exit 0 если процесс есть, 1 иначе. Сигнал не посылается.
		Команда = СтрШаблон("kill -0 %1", Формат(PID, "ЧГ=0;"));
	КонецЕсли;

	Попытка
		ЗапуститьПриложение(Команда, , Истина, КодВозврата);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат КодВозврата = 0;
КонецФункции

#КонецОбласти

#Область РезультатыИЛогирование

Функция НовыйРезультатИнструмента(Успех, Данные, КодОшибки = "", Детали = "")
	Тело = Новый Структура("ok", Успех);
	Если Данные <> Неопределено Тогда
		Тело.Вставить("data", Данные);
	КонецЕсли;
	Если ЗначениеЗаполнено(КодОшибки) Тогда
		Тело.Вставить("error", КодОшибки);
	КонецЕсли;
	Если ЗначениеЗаполнено(Детали) Тогда
		Тело.Вставить("details", Детали);
	КонецЕсли;
	Возврат Мсп_Результаты.JSON(Тело);
КонецФункции

Функция МаскироватьПароль(Команда)
	// Не пропускаем пароль в command_line_preview: `/P"<...>"` → `/P"***"`.
	Позиция = СтрНайти(Команда, "/P""");
	Если Позиция = 0 Тогда
		Возврат Команда;
	КонецЕсли;
	Лево = Лев(Команда, Позиция + 2); // включая `/P"`
	Хвост = Сред(Команда, Позиция + 3); // от первого символа пароля
	Закрытие = СтрНайти(Хвост, """");
	Если Закрытие = 0 Тогда
		Возврат Команда;
	КонецЕсли;
	Возврат Лево + "***" + Сред(Хвост, Закрытие);
КонецФункции

#КонецОбласти

#КонецОбласти
