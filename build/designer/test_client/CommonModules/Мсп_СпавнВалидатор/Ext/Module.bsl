// akimov@gbig
// Валидатор аргументов system_spawn_1c_client / system_kill_pid.
// Защита от shell-injection: allow-list бинарей и /C-ключей, regex-валидация
// значений, бан shell-метасимволов. Парный ADR — docs/decisions/0003-spawn-tools-in-test-client.md.

#Область ПрограммныйИнтерфейс

// Валидирует аргументы system_spawn_1c_client.
//
// Параметры:
//  Аргументы - Структура, Соответствие - Аргументы tool-вызова.
//
// Возвращаемое значение:
//  Структура - Результат:
//   * Успех - Булево - Истина, если все проверки пройдены.
//   * КодОшибки - Строка - "validation_failed" при неуспехе.
//   * Ошибки - Массив из Строка - Список найденных нарушений.
Функция ВалидироватьSpawnАргументы(Аргументы) Экспорт
	Ошибки = Новый Массив;

	Если Не ЭтоКонтейнер(Аргументы) Тогда
		Ошибки.Добавить("arguments must be an object");
		Возврат НовыйРезультатВалидации(Ложь, Ошибки);
	КонецЕсли;

	// Обязательные поля.
	Kind = Прочитать(Аргументы, "kind");
	ClientUID = Прочитать(Аргументы, "client_uid");

	Если Не ЗначениеЗаполнено(Kind) Тогда
		Ошибки.Добавить("kind is required");
	ИначеЕсли Не ЭтоИдентификатор(Kind, 1, 32) Тогда
		Ошибки.Добавить("kind must match [A-Za-z0-9_-]{1,32}");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ClientUID) Тогда
		Ошибки.Добавить("client_uid is required");
	ИначеЕсли Не ЭтоUUID36(ClientUID) Тогда
		Ошибки.Добавить("client_uid must match [0-9a-fA-F-]{36}");
	КонецЕсли;

	// Необязательные поля.
	Бинарь = Прочитать(Аргументы, "binary");
	Если ЗначениеЗаполнено(Бинарь) И Не ВРазрешённыхБинарях(Бинарь) Тогда
		Ошибки.Добавить(СтрШаблон("binary '%1' is not in allow-list (1cv8, 1cv8c, auto)", Бинарь));
	КонецЕсли;

	CorrID = Прочитать(Аргументы, "corr_id");
	Если ЗначениеЗаполнено(CorrID) И Не ЭтоИдентификатор(CorrID, 1, 64) Тогда
		Ошибки.Добавить("corr_id must match [A-Za-z0-9_-]{1,64}");
	КонецЕсли;

	ManagerURL = Прочитать(Аргументы, "manager_url");
	Если ЗначениеЗаполнено(ManagerURL) И Не ЭтоWSURL(ManagerURL) Тогда
		Ошибки.Добавить("manager_url must match ws://… or wss://… with [A-Za-z0-9._:/-] tail");
	КонецЕсли;

	Язык = Прочитать(Аргументы, "language");
	Если ЗначениеЗаполнено(Язык) И Не ВЗначенияхПеречисления(Язык, "ru,en,tr") Тогда
		Ошибки.Добавить("language must be one of ru, en, tr");
	КонецЕсли;

	// Информационная база (опц.).
	IB = Прочитать(Аргументы, "ib");
	Если IB <> Неопределено Тогда
		ВалидироватьIB(IB, Ошибки);
	КонецЕсли;

	// Дополнительные /C-ключи (опц.).
	ExtraC = Прочитать(Аргументы, "extra_c_args");
	Если ExtraC <> Неопределено Тогда
		ВалидироватьExtraC(ExtraC, Ошибки);
	КонецЕсли;

	// Универсальный бан shell-метасимволов по всем строковым значениям первого уровня.
	ПроверитьShellMetacharacters(Аргументы, Ошибки);

	Возврат НовыйРезультатВалидации(Ошибки.Количество() = 0, Ошибки);
КонецФункции

// Валидирует аргументы system_kill_pid.
//
// Параметры:
//  Аргументы - Структура, Соответствие - Аргументы tool-вызова.
//
// Возвращаемое значение:
//  Структура - см. ВалидироватьSpawnАргументы.
Функция ВалидироватьKillАргументы(Аргументы) Экспорт
	Ошибки = Новый Массив;

	Если Не ЭтоКонтейнер(Аргументы) Тогда
		Ошибки.Добавить("arguments must be an object");
		Возврат НовыйРезультатВалидации(Ложь, Ошибки);
	КонецЕсли;

	PID = Прочитать(Аргументы, "pid");
	Если PID = Неопределено Или PID = "" Тогда
		Ошибки.Добавить("pid is required");
	ИначеЕсли ТипЗнч(PID) <> Тип("Число") Тогда
		Ошибки.Добавить("pid must be integer");
	ИначеЕсли PID < 2 Тогда
		Ошибки.Добавить("pid must be >= 2 (PID 1 is forbidden)");
	ИначеЕсли Цел(PID) <> PID Тогда
		Ошибки.Добавить("pid must be integer (no fractional part)");
	КонецЕсли;

	Сигнал = Прочитать(Аргументы, "signal");
	Если ЗначениеЗаполнено(Сигнал) И Не ВЗначенияхПеречисления(Сигнал, "term,kill") Тогда
		Ошибки.Добавить("signal must be one of term, kill");
	КонецЕсли;

	Возврат НовыйРезультатВалидации(Ошибки.Количество() = 0, Ошибки);
КонецФункции

// Проверяет, содержит ли строка запрещённые shell-метасимволы.
//
// Параметры:
//  Значение - Строка - Проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если найден хотя бы один запрещённый символ.
Функция СодержитShellMetacharacter(Значение) Экспорт
	Если ТипЗнч(Значение) <> Тип("Строка") Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрещённые = ЗапрещённыеShellСимволы();
	Для Сч = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Сч, 1);
		Если СтрНайти(Запрещённые, Символ) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;
КонецФункции

// Проверяет, входит ли значение в allow-list бинарей.
//
// Параметры:
//  Значение - Строка - Имя бинаря (1cv8, 1cv8c, auto).
//
// Возвращаемое значение:
//  Булево.
Функция ВРазрешённыхБинарях(Значение) Экспорт
	Возврат ВЗначенияхПеречисления(Значение, "1cv8,1cv8c,auto");
КонецФункции

// Проверяет, входит ли ключ /C в allow-list.
//
// Параметры:
//  Ключ - Строка - Имя ключа.
//
// Возвращаемое значение:
//  Булево.
Функция ВРазрешённыхCКлючах(Ключ) Экспорт
	Возврат ВЗначенияхПеречисления(Ключ, "kind,client_uid,corr_id,manager_url,mcp_ws_timeout_ms,mcpMode");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультатВалидации(Успех, Ошибки)
	Результат = Новый Структура;
	Результат.Вставить("Успех", Успех);
	Результат.Вставить("КодОшибки", ?(Успех, "", "validation_failed"));
	Результат.Вставить("Ошибки", Ошибки);
	Возврат Результат;
КонецФункции

Функция ЭтоКонтейнер(Значение)
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Тип = ТипЗнч(Значение);
	Возврат Тип = Тип("Структура") Или Тип = Тип("Соответствие") Или Тип = Тип("ФиксированнаяСтруктура");
КонецФункции

Функция Прочитать(Контейнер, Ключ)
	Если ТипЗнч(Контейнер) = Тип("Соответствие") Тогда
		Возврат Контейнер.Получить(Ключ);
	КонецЕсли;
	Значение = Неопределено;
	Если ТипЗнч(Контейнер) = Тип("Структура") Или ТипЗнч(Контейнер) = Тип("ФиксированнаяСтруктура") Тогда
		Контейнер.Свойство(Ключ, Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция ВДопустимомНаборе(Значение, ДопустимыеСимволы)
	Если ТипЗнч(Значение) <> Тип("Строка") Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Сч = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(ДопустимыеСимволы, Сред(Значение, Сч, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЭтоИдентификатор(Значение, МинДлина, МаксДлина)
	// Эквивалент regex ^[A-Za-z0-9_-]{Min,Max}$.
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Длина = СтрДлина(Значение);
	Если Длина < МинДлина Или Длина > МаксДлина Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ВДопустимомНаборе(Значение, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-");
КонецФункции

Функция ЭтоUUID36(Значение)
	// Эквивалент regex ^[0-9a-fA-F-]{36}$.
	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ВДопустимомНаборе(Значение, "0123456789abcdefABCDEF-");
КонецФункции

Функция ЭтоWSURL(Значение)
	// Эквивалент regex ^wss?://[A-Za-z0-9._:/-]+$.
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНачинаетсяС(Значение, "wss://") Тогда
		Хвост = Сред(Значение, 7);
	ИначеЕсли СтрНачинаетсяС(Значение, "ws://") Тогда
		Хвост = Сред(Значение, 6);
	Иначе
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Хвост) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ВДопустимомНаборе(Хвост, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._:/-");
КонецФункции

Функция ЭтоИмяСервераИБ(Значение)
	// Эквивалент regex ^[A-Za-z0-9._-]+\\[A-Za-z0-9._-]+$  (сервер\база).
	Если ТипЗнч(Значение) <> Тип("Строка") Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Позиция = СтрНайти(Значение, "\");
	Если Позиция <= 1 Или Позиция >= СтрДлина(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Лево = Лев(Значение, Позиция - 1);
	Право = Сред(Значение, Позиция + 1);
	Если СтрНайти(Право, "\") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Допустимые = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-";
	Возврат ВДопустимомНаборе(Лево, Допустимые) И ВДопустимомНаборе(Право, Допустимые);
КонецФункции

Функция ВЗначенияхПеречисления(Значение, СписокЧерезЗапятую)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Допустимые = СтрРазделить(СписокЧерезЗапятую, ",", Ложь);
	Возврат Допустимые.Найти(Значение) <> Неопределено;
КонецФункции

Функция ЗапрещённыеShellСимволы()
	// Метасимволы Bourne-shell + Windows cmd: команд-сепараторы, пайпы, экспансии,
	// перенаправления, кавычки, подоболочки, переносы строк, подстановки.
	Возврат ";&|$`<>(){}[]!" + Символы.ПС + Символы.ВК + Символы.Таб + """" + "'\";
КонецФункции

Процедура ПроверитьShellMetacharacters(Аргументы, Ошибки)
	// Обходим только верхний уровень и `ib` — этого достаточно, потому что glubже
	// идут перечисления и числа, которые валидируются enum/min/max.
	Поля = Новый Массив;
	Поля.Добавить("kind");
	Поля.Добавить("client_uid");
	Поля.Добавить("corr_id");
	Поля.Добавить("manager_url");
	Поля.Добавить("language");
	Поля.Добавить("binary");

	Для Каждого Имя Из Поля Цикл
		Значение = Прочитать(Аргументы, Имя);
		Если СодержитShellMetacharacter(Значение) Тогда
			Ошибки.Добавить(СтрШаблон("%1 contains shell metacharacter", Имя));
		КонецЕсли;
	КонецЦикла;

	IB = Прочитать(Аргументы, "ib");
	Если ЭтоКонтейнер(IB) Тогда
		Для Каждого ИмяIB Из СтрРазделить("server,user,password", ",", Ложь) Цикл
			Значение = Прочитать(IB, ИмяIB);
			Если СодержитShellMetacharacter(Значение) Тогда
				Ошибки.Добавить(СтрШаблон("ib.%1 contains shell metacharacter", ИмяIB));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ВалидироватьIB(IB, Ошибки)
	Если Не ЭтоКонтейнер(IB) Тогда
		Ошибки.Добавить("ib must be an object");
		Возврат;
	КонецЕсли;

	Сервер = Прочитать(IB, "server");
	Пользователь = Прочитать(IB, "user");
	Пароль = Прочитать(IB, "password");

	Если Не ЗначениеЗаполнено(Сервер) Тогда
		Ошибки.Добавить("ib.server is required");
	ИначеЕсли Не ЭтоИмяСервераИБ(Сервер) Тогда
		Ошибки.Добавить("ib.server must match server\\database with [A-Za-z0-9._-] alphabet");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Ошибки.Добавить("ib.user is required");
	ИначеЕсли Не ВДопустимомНаборе(Пользователь, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-") Или СтрДлина(Пользователь) > 64 Тогда
		Ошибки.Добавить("ib.user must match [A-Za-z0-9._-]{1,64}");
	КонецЕсли;

	Если Пароль <> Неопределено И ТипЗнч(Пароль) = Тип("Строка") И СтрДлина(Пароль) > 128 Тогда
		Ошибки.Добавить("ib.password exceeds 128 chars");
	КонецЕсли;
КонецПроцедуры

Процедура ВалидироватьExtraC(ExtraC, Ошибки)
	Если Не ЭтоКонтейнер(ExtraC) Тогда
		Ошибки.Добавить("extra_c_args must be an object");
		Возврат;
	КонецЕсли;

	Ключи = Новый Массив;
	Для Каждого Элемент Из ExtraC Цикл
		Ключи.Добавить(Элемент.Ключ);
	КонецЦикла;

	Для Каждого Ключ Из Ключи Цикл
		Если Не ВРазрешённыхCКлючах(Ключ) Тогда
			Ошибки.Добавить(СтрШаблон("extra_c_args.%1 is not in allow-list", Ключ));
		КонецЕсли;
	КонецЦикла;

	MCPMode = Прочитать(ExtraC, "mcpMode");
	Если ЗначениеЗаполнено(MCPMode) И Не ВЗначенияхПеречисления(MCPMode, "ws,http,auto") Тогда
		Ошибки.Добавить("extra_c_args.mcpMode must be one of ws, http, auto");
	КонецЕсли;

	Таймаут = Прочитать(ExtraC, "mcp_ws_timeout_ms");
	Если Таймаут <> Неопределено Тогда
		Если ТипЗнч(Таймаут) <> Тип("Число") Или Цел(Таймаут) <> Таймаут Тогда
			Ошибки.Добавить("extra_c_args.mcp_ws_timeout_ms must be integer");
		ИначеЕсли Таймаут < 1 Или Таймаут > 60000 Тогда
			Ошибки.Добавить("extra_c_args.mcp_ws_timeout_ms must be in [1; 60000]");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
