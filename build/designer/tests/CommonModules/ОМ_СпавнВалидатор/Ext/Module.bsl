#Область СлужебныеПроцедурыИФункции

Функция ВалидныеSpawnАргументы()
	Аргументы = Новый Структура;
	Аргументы.Вставить("kind", "test_client");
	Аргументы.Вставить("client_uid", "12345678-1234-1234-1234-1234567890ab");
	Аргументы.Вставить("binary", "auto");
	Возврат Аргументы;
КонецФункции

Процедура ОжидаетсяНарушение(Результат, ПодстрокаОшибки)
	Найдено = Ложь;
	Для Каждого Сообщение Из Результат.Ошибки Цикл
		Если СтрНайти(Сообщение, ПодстрокаОшибки) > 0 Тогда
			Найдено = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не Найдено Тогда
		ВызватьИсключение СтрШаблон(
			"Ожидалось нарушение, содержащее '%1', получено: %2",
			ПодстрокаОшибки,
			СтрСоединить(Результат.Ошибки, "; "));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
