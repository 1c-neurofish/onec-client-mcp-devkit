Процедура BinaryНеИзAllowList_Отказ() Экспорт
	Аргументы = ВалидныеSpawnАргументы();
	Аргументы.Вставить("binary", "rm");

	Результат = Мсп_СпавнВалидатор.ВалидироватьSpawnАргументы(Аргументы);

	ЮТест.ОжидаетЧто(Результат).Свойство("Успех").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат).Свойство("КодОшибки").Равно("validation_failed");
	ОжидаетсяНарушение(Результат, "binary");
КонецПроцедуры

