#Область ПрограммныйИнтерфейс

// Регистрирует сценарии тестового модуля.
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		.ДобавитьТест("URIАктивногоОкнаВозвращаетКонстанту")
		.ДобавитьТест("URIОкнаКодируетСсылку")
		.ДобавитьТест("URIОкнаПустаяСсылкаВозвращаетПустуюСтроку")
		.ДобавитьТест("URIФормыКодируетИмя")
		.ДобавитьТест("URIФормыПустоеИмяВозвращаетПустуюСтроку")
		.ДобавитьТест("URIЭлементаФормыКодируетОба")
		.ДобавитьТест("URIЭлементаФормыПустоеИмяФормыВозвращаетПустуюСтроку")
		.ДобавитьТест("URIЭлементаФормыПустоеИмяЭлементаВозвращаетПустуюСтроку")
		.ДобавитьТест("ЭтоURIОкнаИстинаДляWindowScheme")
		.ДобавитьТест("ЭтоURIОкнаЛожьДляFormScheme")
		.ДобавитьТест("ЭтоURIАктивногоОкнаИстинаДляАктивного")
		.ДобавитьТест("ЭтоURIАктивногоОкнаЛожьДляОбычного")
		.ДобавитьТест("ЭтоURIФормыИстинаДляFormScheme")
		.ДобавитьТест("ЭтоURIФормыЛожьДляControlScheme")
		.ДобавитьТест("ЭтоURIЭлементаФормыИстинаДляControlScheme")
		.ДобавитьТест("ЭтоURIЭлементаФормыЛожьДляFormScheme")
		.ДобавитьТест("СегментОкнаВозвращаетСегмент")
		.ДобавитьТест("СегментОкнаНеURIОкнаВозвращаетПустуюСтроку")
		.ДобавитьТест("СегментФормыВозвращаетСегмент")
		.ДобавитьТест("СегментФормыНеURIФормыВозвращаетПустуюСтроку")
		.ДобавитьТест("СегментыЭлементаФормыВозвращаетОбаСегмента")
		.ДобавитьТест("СегментыЭлементаФормыБезРазделителяВозвращаетНеопределено")
		.ДобавитьТест("СегментыЭлементаФормыНеURIЭлементаВозвращаетНеопределено")
		.ДобавитьТест("ДекодироватьURLАскиСимволы")
		.ДобавитьТест("ДекодироватьURLКириллица")
		.ДобавитьТест("ДекодироватьURLРаундТрип");
КонецПроцедуры

// Проверяет, что URIАктивногоОкна возвращает константу.
Процедура URIАктивногоОкнаВозвращаетКонстанту() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.URIАктивногоОкна()).Равно("window://active");
КонецПроцедуры

// Проверяет кодирование навигационной ссылки в URI окна.
Процедура URIОкнаКодируетСсылку() Экспорт
	URI = Мсп_URIКлиент.URIОкна("e1cib/list/Справочник.Номенклатура");

	ЮТест.ОжидаетЧто(URI).НачинаетсяС("window://");
	ЮТест.ОжидаетЧто(URI).Содержит("e1cib");
КонецПроцедуры

// Проверяет, что пустая ссылка возвращает пустую строку.
Процедура URIОкнаПустаяСсылкаВозвращаетПустуюСтроку() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.URIОкна("")).Равно("");
КонецПроцедуры

// Проверяет кодирование имени формы в URI.
Процедура URIФормыКодируетИмя() Экспорт
	URI = Мсп_URIКлиент.URIФормы("Документ.Заказ");

	ЮТест.ОжидаетЧто(URI).НачинаетсяС("form://");
	ЮТест.ОжидаетЧто(URI).НеРавно("form://");
КонецПроцедуры

// Проверяет, что пустое имя формы возвращает пустую строку.
Процедура URIФормыПустоеИмяВозвращаетПустуюСтроку() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.URIФормы("")).Равно("");
КонецПроцедуры

// Проверяет кодирование имени формы и элемента в URI.
Процедура URIЭлементаФормыКодируетОба() Экспорт
	URI = Мсп_URIКлиент.URIЭлементаФормы("Документ.Заказ", "Сумма");

	ЮТест.ОжидаетЧто(URI).НачинаетсяС("control://");
	ЮТест.ОжидаетЧто(URI).Содержит("/");
КонецПроцедуры

// Проверяет, что пустое имя формы возвращает пустую строку.
Процедура URIЭлементаФормыПустоеИмяФормыВозвращаетПустуюСтроку() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.URIЭлементаФормы("", "Сумма")).Равно("");
КонецПроцедуры

// Проверяет, что пустое имя элемента возвращает пустую строку.
Процедура URIЭлементаФормыПустоеИмяЭлементаВозвращаетПустуюСтроку() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.URIЭлементаФормы("Документ.Заказ", "")).Равно("");
КонецПроцедуры

// Проверяет предикат ЭтоURIОкна для window://.
Процедура ЭтоURIОкнаИстинаДляWindowScheme() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.ЭтоURIОкна("window://active")).ЭтоИстина();
КонецПроцедуры

// Проверяет предикат ЭтоURIОкна для form://.
Процедура ЭтоURIОкнаЛожьДляFormScheme() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.ЭтоURIОкна("form://Документ.Заказ")).ЭтоЛожь();
КонецПроцедуры

// Проверяет предикат ЭтоURIАктивногоОкна для window://active.
Процедура ЭтоURIАктивногоОкнаИстинаДляАктивного() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.ЭтоURIАктивногоОкна("window://active")).ЭтоИстина();
КонецПроцедуры

// Проверяет предикат ЭтоURIАктивногоОкна для обычного URI окна.
Процедура ЭтоURIАктивногоОкнаЛожьДляОбычного() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.ЭтоURIАктивногоОкна("window://e1cib%2Flist")).ЭтоЛожь();
КонецПроцедуры

// Проверяет предикат ЭтоURIФормы для form://.
Процедура ЭтоURIФормыИстинаДляFormScheme() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.ЭтоURIФормы("form://Документ.Заказ")).ЭтоИстина();
КонецПроцедуры

// Проверяет предикат ЭтоURIФормы для control://.
Процедура ЭтоURIФормыЛожьДляControlScheme() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.ЭтоURIФормы("control://Документ.Заказ/Сумма")).ЭтоЛожь();
КонецПроцедуры

// Проверяет предикат ЭтоURIЭлементаФормы для control://.
Процедура ЭтоURIЭлементаФормыИстинаДляControlScheme() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.ЭтоURIЭлементаФормы("control://Документ.Заказ/Сумма")).ЭтоИстина();
КонецПроцедуры

// Проверяет предикат ЭтоURIЭлементаФормы для form://.
Процедура ЭтоURIЭлементаФормыЛожьДляFormScheme() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.ЭтоURIЭлементаФормы("form://Документ.Заказ")).ЭтоЛожь();
КонецПроцедуры

// Проверяет извлечение сегмента из URI окна.
Процедура СегментОкнаВозвращаетСегмент() Экспорт
	URI = "window://e1cib%2Flist%2F%D0%A1%D0%BF%D1%80%D0%B0%D0%B2%D0%BE%D1%87%D0%BD%D0%B8%D0%BA";
	Сегмент = Мсп_URIКлиент.СегментОкна(URI);

	ЮТест.ОжидаетЧто(Сегмент).Равно("e1cib%2Flist%2F%D0%A1%D0%BF%D1%80%D0%B0%D0%B2%D0%BE%D1%87%D0%BD%D0%B8%D0%BA");
КонецПроцедуры

// Проверяет, что не-URI окна возвращает пустую строку.
Процедура СегментОкнаНеURIОкнаВозвращаетПустуюСтроку() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.СегментОкна("form://Документ.Заказ")).Равно("");
КонецПроцедуры

// Проверяет извлечение сегмента из URI формы.
Процедура СегментФормыВозвращаетСегмент() Экспорт
	URI = Мсп_URIКлиент.URIФормы("Документ.Заказ");
	Сегмент = Мсп_URIКлиент.СегментФормы(URI);

	ЮТест.ОжидаетЧто(Сегмент).НеРавно("");
КонецПроцедуры

// Проверяет, что не-URI формы возвращает пустую строку.
Процедура СегментФормыНеURIФормыВозвращаетПустуюСтроку() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.СегментФормы("control://Документ.Заказ/Сумма")).Равно("");
КонецПроцедуры

// Проверяет извлечение обоих сегментов из URI элемента формы.
Процедура СегментыЭлементаФормыВозвращаетОбаСегмента() Экспорт
	URI = Мсп_URIКлиент.URIЭлементаФормы("Документ.Заказ", "Сумма");
	Сегменты = Мсп_URIКлиент.СегментыЭлементаФормы(URI);

	ЮТест.ОжидаетЧто(Сегменты).НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Сегменты)
		.Свойство("СегментФормы").НеРавно("")
		.Свойство("СегментЭлемента").НеРавно("");
КонецПроцедуры

// Проверяет, что URI без разделителя возвращает Неопределено.
Процедура СегментыЭлементаФормыБезРазделителяВозвращаетНеопределено() Экспорт
	// control:// без "/" после сегмента формы
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.СегментыЭлементаФормы("control://ДокументЗаказ")).Равно(Неопределено);
КонецПроцедуры

// Проверяет, что не-URI элемента возвращает Неопределено.
Процедура СегментыЭлементаФормыНеURIЭлементаВозвращаетНеопределено() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.СегментыЭлементаФормы("form://Документ.Заказ")).Равно(Неопределено);
КонецПроцедуры

// Проверяет декодирование ASCII символов.
Процедура ДекодироватьURLАскиСимволы() Экспорт
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.ДекодироватьURL("hello%20world")).Равно("hello world");
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.ДекодироватьURL("%2F")).Равно("/");
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.ДекодироватьURL("%3F")).Равно("?");
КонецПроцедуры

// Проверяет декодирование кириллицы (3-байтовый UTF-8).
Процедура ДекодироватьURLКириллица() Экспорт
	// "Д" = U+0414 = %D0%94
	ЮТест.ОжидаетЧто(Мсп_URIКлиент.ДекодироватьURL("%D0%94")).Равно("Д");
КонецПроцедуры

// Проверяет раунд-трип: кодирование через URIФормы и декодирование.
Процедура ДекодироватьURLРаундТрип() Экспорт
	ИмяФормы = "Документ.Заказ";
	URI = Мсп_URIКлиент.URIФормы(ИмяФормы);
	Сегмент = Мсп_URIКлиент.СегментФормы(URI);
	Декодировано = Мсп_URIКлиент.ДекодироватьURL(Сегмент);

	ЮТест.ОжидаетЧто(Декодировано).Равно(ИмяФормы);
КонецПроцедуры

#КонецОбласти
