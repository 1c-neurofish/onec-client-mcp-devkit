#Область ОписаниеПеременных
Перем Мсп_Состояние Экспорт;
Перем Мсп_СтартИнициирован;
#КонецОбласти

#Область ОбработчикиСобытий

// EN-вход: типовой обработчик англоязычных БСП-конфигураций (Drive, ERP World и т.п.).
&После("OnStart")
Асинх Процедура Мсп_ОнСтарт_EN()
	Ждать Мсп_ИнициироватьСтарт();
КонецПроцедуры

// RU-вход: типовой обработчик русскоязычных БСП-конфигураций (УНФ, ERP, Бухгалтерия и т.п.).
&После("ПриНачалеРаботыСистемы")
Асинх Процедура Мсп_ПриНачалеРаботыСистемы()
	Ждать Мсп_ИнициироватьСтарт();
КонецПроцедуры

// EN-вход: типовой обработчик внешних событий в англоязычных БСП-конфигурациях.
&После("ExternEventProcessing")
Процедура Мсп_ВнешнееСобытие_EN(Источник, Событие, Данные)
	Мсп_ДиспетчерВнешнегоСобытия(Источник, Событие, Данные);
КонецПроцедуры

// RU-вход: типовой обработчик внешних событий в русскоязычных БСП-конфигурациях.
&После("ОбработкаВнешнегоСобытия")
Процедура Мсп_ОбработкаВнешнегоСобытия(Источник, Событие, Данные)
	Мсп_ДиспетчерВнешнегоСобытия(Источник, Событие, Данные);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Идемпотентная инициация старта.
// Защищает от двойного запуска, если конфигурация (нестандартно) имеет
// и OnStart, и ПриНачалеРаботыСистемы, и оба хука сработали.
Асинх Функция Мсп_ИнициироватьСтарт()
	Если Мсп_СтартИнициирован = Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	Мсп_СтартИнициирован = Истина;

	Мсп_Сервер.Инициализировать();
	Возврат Ждать Мсп_ПараметрыЗапускаКлиент.ЗапуститьИзПараметраЗапуска(ПараметрЗапуска);
КонецФункции

// Единый диспетчер внешних событий для EN и RU обёрток.
// События WS-транспорта (режим клиента к session-manager) — отдельный обработчик.
// HTTP-MCP-режим использует прежний путь Мсп_ТранспортСобытияКлиент.
Процедура Мсп_ДиспетчерВнешнегоСобытия(Источник, Событие, Данные)
	Если Источник = "WebTransport" И (Событие = "WS_RECONNECT_STATE" Или Событие = "WS_INCOMING") Тогда
		Мсп_ТранспортСессионКлиент.ОбработатьВнешнееСобытие(Источник, Событие, Данные);
		Возврат;
	КонецЕсли;

	Мсп_ТранспортСобытияКлиент.ОбработатьВнешнееСобытие(Источник, Событие, Данные);
КонецПроцедуры

#КонецОбласти
