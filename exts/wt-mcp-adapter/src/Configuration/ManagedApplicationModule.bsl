#Область ОписаниеПеременных
Перем Мсп_Состояние Экспорт;
Перем Мсп_СохраненныйПараметрЗапуска;
Перем Мсп_СтартИнициирован;
#КонецОбласти

#Область ОбработчикиСобытий

// EN-вход: типовой обработчик англоязычных БСП-конфигураций (Drive, ERP World и т.п.).
&После("OnStart")
Процедура Мсп_ОнСтарт_EN()
	Мсп_ОтладочныйЛог("&После(OnStart) hook fired");
	Мсп_ИнициироватьОтложенныйСтарт();
КонецПроцедуры

// RU-вход: типовой обработчик русскоязычных БСП-конфигураций (УНФ, ERP, Бухгалтерия и т.п.).
&После("ПриНачалеРаботыСистемы")
Процедура Мсп_ОнСтарт_RU()
	Мсп_ОтладочныйЛог("&После(ПриНачалеРаботыСистемы) hook fired");
	Мсп_ИнициироватьОтложенныйСтарт();
КонецПроцедуры

// EN-вход: типовой обработчик внешних событий в англоязычных БСП-конфигурациях.
&После("ExternEventProcessing")
Процедура Мсп_ВнешнееСобытие_EN(Источник, Событие, Данные)
	Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР("Мсп.ХукEN", "fired src=" + Строка(Источник) + " evt=" + Строка(Событие));
	Мсп_ДиспетчерВнешнегоСобытия(Источник, Событие, Данные);
КонецПроцедуры

// RU-вход: типовой обработчик внешних событий в русскоязычных БСП-конфигурациях.
&После("ОбработкаВнешнегоСобытия")
Процедура Мсп_ВнешнееСобытие_RU(Источник, Событие, Данные)
	Мсп_ДиспетчерВнешнегоСобытия(Источник, Событие, Данные);
КонецПроцедуры

// EN-вход: типовой обработчик завершения работы в англоязычных БСП-конфигурациях.
&После("BeforeExit")
Процедура Мсп_ПередЗавершением_EN(Отказ, ТекстПредупреждения)
	Мсп_ДиспетчерЗавершенияРаботы();
КонецПроцедуры

// RU-вход: типовой обработчик завершения работы в русскоязычных БСП-конфигурациях.
&После("ПередЗавершениемРаботыСистемы")
Процедура Мсп_ПередЗавершением_RU(Отказ, ТекстПредупреждения)
	Мсп_ДиспетчерЗавершенияРаботы();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Идемпотентная инициация отложенного асинхронного старта.
// Защищает от двойного запуска, если конфигурация (нестандартно) имеет
// и OnStart, и ПриНачалеРаботыСистемы, и оба хука сработали.
Процедура Мсп_ИнициироватьОтложенныйСтарт()
	Если Мсп_СтартИнициирован = Истина Тогда
		Мсп_ОтладочныйЛог("InitDeferredStart: пропущен (уже инициирован)");
		Возврат;
	КонецЕсли;
	Мсп_СтартИнициирован = Истина;
	Мсп_СохраненныйПараметрЗапуска = ПараметрЗапуска;

	Мсп_ОтладочныйЛог("ПараметрЗапуска=[" + ПараметрЗапуска + "]");
	// Интервал 0.1с критичен для гонки с YAXUNIT (closeAfterTests=true закрывает сеанс за ~1с).
	ПодключитьОбработчикОжидания("Мсп_ОтложенныйСтарт_Тик", 0.1, Истина);
	Мсп_ОтладочныйЛог("Idle-handler Мсп_ОтложенныйСтарт_Тик scheduled (0.1s, single-shot)");
КонецПроцедуры

// Единый диспетчер внешних событий для EN и RU обёрток.
Процедура Мсп_ДиспетчерВнешнегоСобытия(Источник, Событие, Данные)
	Мсп_ОтладочныйЛог("ExternalEvent: src=" + Источник + " evt=" + Событие);
	Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
		"Мсп.ВнешнееСобытие",
		"src=" + Строка(Источник) + " evt=" + Строка(Событие) + " data=" + Строка(Данные));

	Если Источник = "WebTransport" И (Событие = "WS_RECONNECT_STATE" Или Событие = "WS_INCOMING") Тогда
		Мсп_ТранспортСессионКлиент.ОбработатьВнешнееСобытие(Источник, Событие, Данные);
		Возврат;
	КонецЕсли;

	Мсп_ТранспортСобытияКлиент.ОбработатьВнешнееСобытие(Источник, Событие, Данные);
КонецПроцедуры

// Идемпотентная финализация при выходе из 1С: гасит WS-интеграцию и сбрасывает
// singleton компоненты транспорта, чтобы менеджер сессий получил корректный close
// (а не повис в keep-alive timeout).
Процедура Мсп_ДиспетчерЗавершенияРаботы()
	Мсп_ОтладочныйЛог("BeforeExit hook fired");
	Попытка
		Мсп_ТранспортСессионКлиент.ОстановитьИОсвободитьКомпоненту();
	Исключение
		Мсп_ОтладочныйЛог("BeforeExit cleanup ИСКЛ: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Однократный idle-handler: запускает асинхронную инициализацию сервера и WS/HTTP старт.
Асинх Процедура Мсп_ОтложенныйСтарт_Тик() Экспорт

	Мсп_ОтладочныйЛог("=== Мсп_ОтложенныйСтарт_Тик ENTER ===");

	Попытка
		ФайлЛогаКлиента = КаталогВременныхФайлов() + "mcp-client.log";
		// Применяем уровень из /C mcp_log_level ДО регистрации провайдеров,
		// чтобы Информация-сообщения регистрации не пробивались в UI-панель
		// при недопустимых конфиг-уровнях (warn/error/off).
		Мсп_ПараметрыЗапускаКлиент.ПрименитьЛогированиеИзПараметраЗапуска(
			Мсп_СохраненныйПараметрЗапуска, ФайлЛогаКлиента);
		Мсп_ОтладочныйЛог("Уровень логирования применён из /C; файл=" + ФайлЛогаКлиента);
	Исключение
		Мсп_ОтладочныйЛог("Логирование НЕ применено: " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Мсп_Сервер.Инициализировать();
		Мсп_ОтладочныйЛог("Мсп_Сервер.Инициализировать выполнено");
	Исключение
		Мсп_ОтладочныйЛог("Мсп_Сервер.Инициализировать ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Мсп_ОтладочныйЛог("ПЕРЕД Ждать: тип ПараметрЗапуска=" + ?(Мсп_СохраненныйПараметрЗапуска = Неопределено, "Неопределено", "Строка len=" + Строка(СтрДлина(Строка(Мсп_СохраненныйПараметрЗапуска)))));

	Попытка
		Результат = Ждать Мсп_ПараметрыЗапускаКлиент.ЗапуститьИзПараметраЗапуска(Мсп_СохраненныйПараметрЗапуска);
		ТипРезультата = ?(Результат = Неопределено, "Неопределено", Строка(ТипЗнч(Результат)));
		Мсп_ОтладочныйЛог("ПОСЛЕ Ждать: тип результата=" + ТипРезультата);
		Мсп_ОтладочныйЛог("ЗапуститьИзПараметраЗапуска вернул: " + ?(Результат = Неопределено, "Неопределено", "не-Неопределено"));
	Исключение
		Мсп_ОтладочныйЛог("ЗапуститьИзПараметраЗапуска ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Мсп_ОтладочныйЛог("ПОСЛЕ КонецПопытки (перед EXIT)");

	Мсп_ОтладочныйЛог("=== Мсп_ОтложенныйСтарт_Тик EXIT ===");

КонецПроцедуры

// Прямая запись в файл + дубль в ЖР, не зависящая от Мсп_ЛогированиеКлиент.
// Файловая запись может молча падать (safe-mode на Windows-расширении), поэтому
// для гарантированной трассировки старта дублируем в журнал регистрации.
Процедура Мсп_ОтладочныйЛог(Сообщение)
	Попытка
		ФайлБутстрапа = КаталогВременныхФайлов() + "mcp-bootstrap.log";
		Запись = Новый ЗаписьТекста(ФайлБутстрапа, КодировкаТекста.UTF8, Символы.ПС, Истина);
		Запись.ЗаписатьСтроку(Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm:ss'") + " " + Сообщение);
		Запись.Закрыть();
	Исключение
	КонецПопытки;

	Попытка
		Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР("Мсп.Бутстрап", Строка(Сообщение));
	Исключение
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
