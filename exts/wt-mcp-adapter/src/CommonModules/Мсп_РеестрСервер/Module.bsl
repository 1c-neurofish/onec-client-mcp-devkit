#Область ПрограммныйИнтерфейс

// Создает аккумулятор серверных инструментов hub.
//
// Возвращаемое значение:
//  Структура - реестр серверных инструментов:
//   * Инструменты - Массив - описания инструментов.
Функция НовыйРеестр() Экспорт

	Реестр = Новый Структура;
	Реестр.Вставить("Инструменты", Новый Массив);

	Возврат Реестр;

КонецФункции

// Добавляет описание серверного инструмента в аккумулятор.
//
// Параметры:
//  Реестр - Структура - аккумулятор из НовыйРеестр().
//  ОписаниеИнструмента - Структура - описание серверного инструмента:
//   * Имя - Строка - идентификатор инструмента.
//   * Описание - Строка - описание для MCP tools/list.
//   * СхемаПараметров - Структура - JSON-схема входных параметров.
//   * КоординатаИсполнения - Структура - поля ИмяМодуля, ИмяКонтейнера.
Процедура ЗарегистрироватьИнструмент(Реестр, ОписаниеИнструмента) Экспорт

	ПроверитьРеестр(Реестр);
	ПроверитьОписаниеИнструмента(ОписаниеИнструмента);

	Если НайтиПоИмени(Реестр, ОписаниеИнструмента.Имя) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru='Серверный инструмент ""%1"" уже зарегистрирован'"),
			ОписаниеИнструмента.Имя);
	КонецЕсли;

	Реестр.Инструменты.Добавить(ОписаниеИнструмента);

КонецПроцедуры

// Возвращает первое описание серверного инструмента по имени.
//
// Параметры:
//  Реестр - Структура - аккумулятор из НовыйРеестр().
//  ИмяИнструмента - Строка - идентификатор инструмента.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание инструмента.
Функция НайтиПоИмени(Реестр, ИмяИнструмента) Экспорт

	ПроверитьРеестр(Реестр);

	Для Каждого ОписаниеИнструмента Из Реестр.Инструменты Цикл
		Если ОписаниеИнструмента.Имя = ИмяИнструмента Тогда
			Возврат ОписаниеИнструмента;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает копию массива инструментов для чтения внешним кодом.
//
// Параметры:
//  Реестр - Структура - аккумулятор из НовыйРеестр().
//
// Возвращаемое значение:
//  Массив - описания серверных инструментов.
Функция Инструменты(Реестр) Экспорт

	ПроверитьРеестр(Реестр);

	Результат = Новый Массив;
	Для Каждого ОписаниеИнструмента Из Реестр.Инструменты Цикл
		Результат.Добавить(ОписаниеИнструмента);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьРеестр(Реестр)

	Если ТипЗнч(Реестр) <> Тип("Структура") Или Не Реестр.Свойство("Инструменты") Тогда
		ВызватьИсключение НСтр("ru='Некорректный реестр серверных инструментов'");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОписаниеИнструмента(ОписаниеИнструмента)

	Если ТипЗнч(ОписаниеИнструмента) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru='Описание серверного инструмента должно быть структурой'");
	КонецЕсли;

	ПроверитьПолеОписания(ОписаниеИнструмента, "Имя");
	ПроверитьПолеОписания(ОписаниеИнструмента, "Описание");
	ПроверитьПолеОписания(ОписаниеИнструмента, "СхемаПараметров");
	ПроверитьПолеОписания(ОписаниеИнструмента, "КоординатаИсполнения");
	ПроверитьКоординатуИсполнения(ОписаниеИнструмента.КоординатаИсполнения);

КонецПроцедуры

Процедура ПроверитьПолеОписания(ОписаниеИнструмента, ИмяПоля)

	Если Не ОписаниеИнструмента.Свойство(ИмяПоля) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru='В описании серверного инструмента не заполнено поле ""%1""'"),
			ИмяПоля);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьКоординатуИсполнения(КоординатаИсполнения)

	Если ТипЗнч(КоординатаИсполнения) <> Тип("Структура")
		Или Не КоординатаИсполнения.Свойство("ИмяМодуля")
		Или Не КоординатаИсполнения.Свойство("ИмяКонтейнера") Тогда
		ВызватьИсключение НСтр("ru='Координата исполнения должна содержать ИмяМодуля и ИмяКонтейнера'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
