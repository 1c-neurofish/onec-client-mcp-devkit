#Область ПрограммныйИнтерфейс

// Создает описание серверного инструмента hub.
//
// Параметры:
//  ИмяИнструмента - Строка - идентификатор инструмента.
//  Описание - Строка - описание для MCP tools/list.
//  СхемаПараметров - Структура - JSON-схема входных параметров.
//  КоординатаИсполнения - Структура - поля:
//   * ИмяМодуля - Строка - серверный модуль-исполнитель.
//   * ИмяКонтейнера - Строка - контейнер инструмента внутри spoke.
//
// Возвращаемое значение:
//  Структура - описание серверного инструмента.
Функция НовыйИнструмент(ИмяИнструмента, Описание, СхемаПараметров, КоординатаИсполнения) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Имя", ИмяИнструмента);
	Результат.Вставить("Описание", Описание);
	Результат.Вставить("СхемаПараметров", ?(СхемаПараметров = Неопределено, Новый Структура, СхемаПараметров));
	Результат.Вставить("КоординатаИсполнения", КоординатаИсполнения);
	Результат.Вставить("Включён", Истина);

	Возврат Результат;

КонецФункции

// Добавляет серверный инструмент в реестр hub.
//
// Параметры:
//  Реестр - Структура - аккумулятор Мсп_РеестрСервер.НовыйРеестр().
//  ИмяИнструмента - Строка - идентификатор инструмента.
//  Описание - Строка - описание для MCP tools/list.
//  СхемаПараметров - Структура - JSON-схема входных параметров.
//  КоординатаИсполнения - Структура - поля ИмяМодуля, ИмяКонтейнера.
Процедура ДобавитьИнструмент(Реестр, ИмяИнструмента, Описание, СхемаПараметров, КоординатаИсполнения) Экспорт

	ОписаниеИнструмента = НовыйИнструмент(
		ИмяИнструмента,
		Описание,
		СхемаПараметров,
		КоординатаИсполнения);

	Мсп_РеестрСервер.ЗарегистрироватьИнструмент(Реестр, ОписаниеИнструмента);

КонецПроцедуры

// Строит серверный реестр через серверный extension-point.
//
// Возвращаемое значение:
//  Структура - аккумулятор серверных инструментов.
Функция ПостроитьРеестр() Экспорт

	Возврат Мсп_СерверныеПровайдерыСервер.ПостроитьРеестр();

КонецФункции

// Возвращает серверный инструмент по имени из переданного реестра.
//
// Параметры:
//  Реестр - Структура - аккумулятор серверных инструментов.
//  ИмяИнструмента - Строка - идентификатор инструмента.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание инструмента.
Функция НайтиИнструмент(Реестр, ИмяИнструмента) Экспорт

	Возврат Мсп_РеестрСервер.НайтиПоИмени(Реестр, ИмяИнструмента);

КонецФункции

// Выполняет серверный инструмент через координату исполнения в реестре.
//
// Параметры:
//  Реестр - Структура - аккумулятор серверных инструментов.
//  ИмяИнструмента - Строка - идентификатор инструмента.
//  Аргументы - Структура - аргументы tools/call.
//
// Возвращаемое значение:
//  Произвольный - результат метода ВыполнитьИнструмент() provider-модуля.
Функция ВыполнитьИнструмент(Реестр, ИмяИнструмента, Аргументы) Экспорт

	ОписаниеИнструмента = НайтиИнструмент(Реестр, ИмяИнструмента);
	Если ОписаниеИнструмента = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru='Серверный инструмент ""%1"" не зарегистрирован'"),
			ИмяИнструмента);
	КонецЕсли;

	КоординатаИсполнения = ОписаниеИнструмента.КоординатаИсполнения;
	МодульИсполнителя = МодульИсполнителя(КоординатаИсполнения.ИмяМодуля);

	Возврат МодульИсполнителя.ВыполнитьИнструмент(
		КоординатаИсполнения.ИмяКонтейнера,
		ИмяИнструмента,
		Аргументы);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МодульИсполнителя(ИмяМодуля)

	МодульЧерезБСП = МодульИсполнителяЧерезБСП(ИмяМодуля);
	Если МодульЧерезБСП <> Неопределено Тогда
		Возврат МодульЧерезБСП;
	КонецЕсли;

	Попытка
		Возврат Вычислить(ИмяМодуля);
	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		ВызватьИсключение СтрШаблон(
			НСтр("ru='Не удалось получить серверный модуль ""%1"": %2'"),
			ИмяМодуля,
			ПодробноеПредставлениеОшибки(ИнфоОшибки));
	КонецПопытки;

КонецФункции

Функция МодульИсполнителяЧерезБСП(ИмяМодуля)

	// В hub-контуре БСП может отсутствовать, поэтому обращение к ОбщегоНазначения
	// выполняется через динамический resolver и безопасно падает в fallback.
	Попытка
		МодульОбщегоНазначения = Вычислить("ОбщегоНазначения");
		Возврат МодульОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти
