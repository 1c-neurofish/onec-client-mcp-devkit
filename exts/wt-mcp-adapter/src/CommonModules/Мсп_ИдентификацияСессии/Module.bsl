//++akimov.dssl [09.05.2026 12:04:47] #session-register-payload-extension-20260509
// Возвращает имя текущей информационной базы.
//
// Источник — платформенная функция СтрокаСоединенияИнформационнойБазы().
// Для серверного варианта строки соединения (Srvr=...;Ref="<name>";...) функция
// извлекает значение ключа Ref. Для файлового варианта (File="<path>";...) —
// последний компонент пути из File. Если ни Ref, ни File не найдены — "unknown".
//
// Возвращаемое значение:
//  Строка - имя ИБ (например, "dssl_drive_ai") либо "unknown".
Функция ИмяИнформационнойБазы() Экспорт
	Возврат ИмяИБИзСтрокиСоединения(СтрокаСоединенияИнформационнойБазы());
КонецФункции ///akimov.dssl [09.05.2026 12:04:47]

//++akimov.dssl [09.05.2026 12:04:47] #session-register-payload-extension-20260509
// Парсит произвольную строку соединения с ИБ и возвращает имя базы.
//
// Чистая функция (без обращения к платформенной СтрокаСоединенияИнформационнойБазы),
// чтобы её можно было покрыть unit-тестами с детерминированными входными данными.
//
// Семантика:
//  • Строка соединения — это набор пар Ключ=Значение, разделённых ";".
//  • Значение может быть в кавычках ("...") или без них (до следующей ";" или конца).
//  • Если есть ключ Ref — возвращаем его значение (серверная ИБ).
//  • Иначе если есть ключ File — берём его значение и возвращаем последний компонент
//    пути (после последнего "/" или "\\").
//  • Иначе — "unknown".
//
// Параметры:
//  СтрокаСоединения - Строка - сырая строка соединения вида
//                     `Srvr="onec-infra";Ref="dssl_drive_ai";` или
//                     `File="/var/1c/bases/test_base";`.
//
// Возвращаемое значение:
//  Строка - имя ИБ либо "unknown".
Функция ИмяИБИзСтрокиСоединения(СтрокаСоединения) Экспорт

	Если ТипЗнч(СтрокаСоединения) <> Тип("Строка") Или Не ЗначениеЗаполнено(СтрокаСоединения) Тогда
		Возврат "unknown";
	КонецЕсли;

	ЗначениеRef = ИзвлечьЗначениеКлюча(СтрокаСоединения, "Ref");
	Если ЗначениеЗаполнено(ЗначениеRef) Тогда
		Возврат ЗначениеRef;
	КонецЕсли;

	ЗначениеFile = ИзвлечьЗначениеКлюча(СтрокаСоединения, "File");
	Если ЗначениеЗаполнено(ЗначениеFile) Тогда
		Возврат ПоследнийКомпонентПути(ЗначениеFile);
	КонецЕсли;

	Возврат "unknown";

КонецФункции ///akimov.dssl [09.05.2026 12:04:47]

