//++akimov.dssl [09.05.2026 12:04:47] #session-register-payload-extension-20260509
// Извлекает значение ключа из строки вида `Key1=Val1;Key2="Val2";...`.
// Возвращает пустую строку, если ключ не найден.
//
// Параметры:
//  СтрокаСоединения - Строка - входная строка соединения.
//  ИмяКлюча         - Строка - имя ключа без знака равенства.
//
// Возвращаемое значение:
//  Строка - значение ключа без обрамляющих кавычек либо "".
Функция ИзвлечьЗначениеКлюча(СтрокаСоединения, ИмяКлюча)

	Сегменты = СтрРазделить(СтрокаСоединения, ";", Ложь);

	Для Каждого Сегмент Из Сегменты Цикл
		ОбрезанныйСегмент = СокрЛП(Сегмент);
		Если Не ЗначениеЗаполнено(ОбрезанныйСегмент) Тогда
			Продолжить;
		КонецЕсли;

		ПозицияРавно = СтрНайти(ОбрезанныйСегмент, "=");
		Если ПозицияРавно <= 1 Тогда
			Продолжить;
		КонецЕсли;

		КлючСегмента = СокрЛП(Лев(ОбрезанныйСегмент, ПозицияРавно - 1));
		Если ВРег(КлючСегмента) <> ВРег(ИмяКлюча) Тогда
			Продолжить;
		КонецЕсли;

		ЗначениеСегмента = СокрЛП(Сред(ОбрезанныйСегмент, ПозицияРавно + 1));

		// Снимаем обрамляющие двойные кавычки, если есть.
		Если СтрДлина(ЗначениеСегмента) >= 2
			И Лев(ЗначениеСегмента, 1) = """"
			И Прав(ЗначениеСегмента, 1) = """" Тогда
			ЗначениеСегмента = Сред(ЗначениеСегмента, 2, СтрДлина(ЗначениеСегмента) - 2);
		КонецЕсли;

		Возврат ЗначениеСегмента;
	КонецЦикла;

	Возврат "";

КонецФункции ///akimov.dssl [09.05.2026 12:04:47]

//++akimov.dssl [09.05.2026 12:04:47] #session-register-payload-extension-20260509
// Возвращает последний компонент пути (после последнего "/" или "\\").
// Если разделителей нет — возвращает исходное значение.
// Хвостовые разделители "/" / "\\" игнорируются.
Функция ПоследнийКомпонентПути(Знач Путь)

	Путь = СокрЛП(Путь);

	// Срезаем хвостовые разделители.
	Пока СтрДлина(Путь) > 0 И (Прав(Путь, 1) = "/" Или Прав(Путь, 1) = "\") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат "";
	КонецЕсли;

	ПозицияСлеша = СтрНайти(Путь, "/", НаправлениеПоиска.СКонца);
	ПозицияБэка  = СтрНайти(Путь, "\", НаправлениеПоиска.СКонца);
	ПозицияРазделителя = ?(ПозицияСлеша > ПозицияБэка, ПозицияСлеша, ПозицияБэка);

	Если ПозицияРазделителя = 0 Тогда
		Возврат Путь;
	КонецЕсли;

	Возврат Сред(Путь, ПозицияРазделителя + 1);

КонецФункции ///akimov.dssl [09.05.2026 12:04:47]

