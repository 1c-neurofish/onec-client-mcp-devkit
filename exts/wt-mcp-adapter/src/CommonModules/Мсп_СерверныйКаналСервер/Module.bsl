#Область ПрограммныйИнтерфейс

// Возвращает фактические параметры серверного канала с учётом persistent-настройки,
// потому что регламентное задание не получает `/C` параметры тонкого клиента.
//
// Возвращаемое значение:
//  Структура - resolved-настройки серверного канала.
Функция ПолучитьПараметрыКанала() Экспорт

	Возврат ПодготовитьПараметрыКанала(Неопределено);

КонецФункции

// Сохраняет persistent-настройку серверного канала для rphost.
//
// Параметры:
//  Параметры - Структура - настройки серверного канала.
Процедура ЗаписатьПараметрыКанала(Параметры) Экспорт

	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru='Параметры серверного MCP-канала должны быть структурой'");
	КонецЕсли;

	НормализованныеПараметры = ПодготовитьПостоянныеПараметрыКанала(Параметры);
	ХранилищеОбщихНастроек.Сохранить(
		КлючОбщегоХранилищаКанала(),
		"ПараметрыКанала",
		НормализованныеПараметры,
		,
		"");

КонецПроцедуры

// Проверяет из серверного контекста, может ли ВК открыть WS к manager.
// session.register не отправляется, чтобы probe не создавал видимую MCP-сессию.
//
// Параметры:
//  Адрес      - Строка - проверяемый manager_url; если пустой, используется resolved-настройка.
//  ТаймаутМс  - Число - максимальная длительность проверки.
//  УровеньЛогирования - Строка - диагностический уровень ВК на время probe.
//
// Возвращаемое значение:
//  Структура - поля ok, url, state, error, elapsed_ms, corr_id.
Функция ПроверитьДоступностьМенеджера(Адрес = "", ТаймаутМс = 3000, УровеньЛогирования = "") Экспорт

	Параметры = ПодготовитьПараметрыКанала(Неопределено);
	Если ЗначениеЗаполнено(Адрес) Тогда
		Параметры.manager_url = Строка(Адрес);
	КонецЕсли;
	Параметры.client_uid = "probe-" + Строка(Новый УникальныйИдентификатор);
	Параметры.kind = "server";
	Параметры.corr_id = Строка(Новый УникальныйИдентификатор);
	Параметры.mcp_log_level = Строка(УровеньЛогирования);

	ТаймаутПроверкиМс = НормализоватьТаймаутПроверки(ТаймаутМс);
	Результат = Новый Структура;
	Результат.Вставить("ok", Ложь);
	Результат.Вставить("url", Параметры.manager_url);
	Результат.Вставить("state", "");
	Результат.Вставить("error", "");
	Результат.Вставить("elapsed_ms", 0);
	Результат.Вставить("corr_id", Параметры.corr_id);

	НачалоПроверки = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Компонента = Неопределено;
	Попытка
		Компонента = ПодключитьКомпоненту();
		НастроитьЛогированиеКомпоненты(Компонента, Параметры.mcp_log_level);
		ЗапуститьИнтеграцию(Компонента, Параметры);
		ОжидатьДоступностьМенеджера(Компонента, Результат, НачалоПроверки, ТаймаутПроверкиМс);
	Исключение
		Результат.error = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	// Probe не регистрирует серверную сессию, поэтому ВК нужно остановить сразу
	// после проверки, чтобы не держать лишний WS pump в rphost.
	ОстановитьКомпоненту(Компонента);
	Результат.elapsed_ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПроверки;

	Возврат Результат;

КонецФункции

// Поддерживает серверный WS-канал MCP в одном тике регламентного задания.
//
// Параметры:
//  ПараметрыКанала - Структура, Неопределено - необязательные настройки:
//   * manager_url - Строка - URL session-manager.
//   * client_uid - Строка - идентификатор серверной сессии.
//   * corr_id - Строка - correlation id для логов manager/addin.
//   * mcp_log_level - Строка - уровень логирования addin.
//   * tick_seconds - Число - максимальная длительность polling-тика.
//   * poll_timeout_ms - Число - таймаут одного ПолучитьСообщение().
Процедура ПоддержатьКанал(ПараметрыКанала = Неопределено) Экспорт

	Параметры = ПодготовитьПараметрыКанала(ПараметрыКанала);

	Если ДругоеАктивноеЗаданиеСКлючом(КлючФоновогоЗадания()) Тогда
		ЗаписатьВЖР("GuardSkip", "уже есть активный тик с ключом " + КлючФоновогоЗадания());
		Возврат;
	КонецЕсли;

	Компонента = Неопределено;
	Попытка
		Реестр = Мсп_СерверСервер.ПостроитьРеестр();
		ЗаписатьВЖР("Start", СтрШаблон(
			"manager=%1 uid=%2 tools=%3 tick=%4 poll=%5",
			Параметры.manager_url,
			Параметры.client_uid,
			Мсп_РеестрСервер.Инструменты(Реестр).Количество(),
			Параметры.tick_seconds,
			Параметры.poll_timeout_ms));

		Компонента = ПодключитьКомпоненту();
		НастроитьЛогированиеКомпоненты(Компонента, Параметры.mcp_log_level);
		ЗапуститьИнтеграцию(Компонента, Параметры);
		ОтправитьSessionRegister(Компонента, Параметры, Реестр);
		ЦиклPolling(Компонента, Реестр, Параметры);
	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		ЗаписатьВЖР("Error", ПодробноеПредставлениеОшибки(ИнфоОшибки), УровеньЖурналаРегистрации.Ошибка);
		ОстановитьКомпоненту(Компонента);
		ВызватьИсключение;
	КонецПопытки;

	ОстановитьКомпоненту(Компонента);
	ЗаписатьВЖР("Stop", "тик завершен");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодготовитьПараметрыКанала(ПараметрыКанала)

	Параметры = Новый Структура;
	Параметры.Вставить("manager_url", ManagerURLПоУмолчанию());
	Параметры.Вставить("client_uid", "server-" + Мсп_ИдентификацияСессии.ИмяИнформационнойБазы());
	Параметры.Вставить("kind", "server");
	Параметры.Вставить("corr_id", Строка(Новый УникальныйИдентификатор));
	Параметры.Вставить("mcp_log_level", "");
	Параметры.Вставить("tick_seconds", 50);
	Параметры.Вставить("poll_timeout_ms", 1000);

	СкопироватьПостоянныеПараметрыВКанал(Параметры, ЗагрузитьПостоянныеПараметрыКанала());

	Если ТипЗнч(ПараметрыКанала) = Тип("Структура") Тогда
		СкопироватьПараметрыКанала(Параметры, ПараметрыКанала);
	КонецЕсли;

	Возврат Параметры;

КонецФункции

Функция ЗагрузитьПостоянныеПараметрыКанала()

	// Регламентное задание не получает /C тонкого клиента, поэтому серверный канал
	// читает администраторскую настройку из платформенного общего хранилища.
	Попытка
		Значение = ХранилищеОбщихНастроек.Загрузить(
			КлючОбщегоХранилищаКанала(),
			"ПараметрыКанала",
			,
			"");
	Исключение
		ЗаписатьВЖР("Settings", "не удалось прочитать ХранилищеОбщихНастроек: " + ОписаниеОшибки());
		Возврат Новый Структура;
	КонецПопытки;

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Новый Структура;

КонецФункции

Функция КлючОбщегоХранилищаКанала()

	Возврат "Мсп_СерверныйКаналСервер";

КонецФункции

Функция ПодготовитьПостоянныеПараметрыКанала(Параметры)

	ПостоянныеПараметры = Новый Структура;
	СкопироватьПостоянныйПараметр(ПостоянныеПараметры, Параметры, "manager_url", Истина);
	СкопироватьПостоянныйПараметр(ПостоянныеПараметры, Параметры, "client_uid");
	СкопироватьПостоянныйПараметр(ПостоянныеПараметры, Параметры, "mcp_log_level");
	СкопироватьЧисловойПараметр(ПостоянныеПараметры, Параметры, "tick_seconds", 1, 3600);
	СкопироватьЧисловойПараметр(ПостоянныеПараметры, Параметры, "poll_timeout_ms", 50, 60000);

	Возврат ПостоянныеПараметры;

КонецФункции

Процедура СкопироватьПостоянныеПараметрыВКанал(Параметры, Источник)

	Если ТипЗнч(Источник) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	СкопироватьПостоянныйПараметр(Параметры, Источник, "manager_url", Истина);
	СкопироватьПостоянныйПараметр(Параметры, Источник, "client_uid");
	СкопироватьПостоянныйПараметр(Параметры, Источник, "mcp_log_level");
	СкопироватьЧисловойПараметр(Параметры, Источник, "tick_seconds", 1, 3600);
	СкопироватьЧисловойПараметр(Параметры, Источник, "poll_timeout_ms", 50, 60000);

КонецПроцедуры

Процедура СкопироватьПостоянныйПараметр(Параметры, Источник, ИмяПараметра, ЭтоManagerURL = Ложь)

	Значение = Неопределено;
	Если Не Источник.Свойство(ИмяПараметра, Значение) Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоManagerURL И Не ЭтоWSURL(Значение) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru='manager_url должен начинаться с ws:// или wss:// и содержать только безопасные символы: %1'"),
			Строка(Значение));
	КонецЕсли;

	Если ЗначениеЗаполнено(Значение) Тогда
		Параметры.Вставить(ИмяПараметра, Строка(Значение));
	КонецЕсли;

КонецПроцедуры

Процедура СкопироватьПараметрыКанала(Параметры, Источник)

	Если ТипЗнч(Источник) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	СкопироватьПараметр(Параметры, Источник, "manager_url");
	СкопироватьПараметр(Параметры, Источник, "client_uid");
	СкопироватьПараметр(Параметры, Источник, "corr_id");
	СкопироватьПараметр(Параметры, Источник, "mcp_log_level");
	СкопироватьЧисловойПараметр(Параметры, Источник, "tick_seconds", 1, 3600);
	СкопироватьЧисловойПараметр(Параметры, Источник, "poll_timeout_ms", 50, 60000);

КонецПроцедуры

Функция ManagerURLПоУмолчанию()

	Хост = "127" + ".0.0.1";
	Возврат "ws://" + Хост + ":4000/sessions";

КонецФункции

Функция ЭтоWSURL(Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если СтрНачинаетсяС(Значение, "wss://") Тогда
		Хвост = Сред(Значение, 7);
	ИначеЕсли СтрНачинаетсяС(Значение, "ws://") Тогда
		Хвост = Сред(Значение, 6);
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Хвост) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ВДопустимомНаборе(Хвост, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._:/-");

КонецФункции

Функция ВДопустимомНаборе(Значение, ДопустимыеСимволы)

	Если ТипЗнч(Значение) <> Тип("Строка") Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для ИндексСимвола = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(ДопустимыеСимволы, Сред(Значение, ИндексСимвола, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура СкопироватьПараметр(Параметры, Источник, ИмяПараметра)

	Значение = Неопределено;
	Если Источник.Свойство(ИмяПараметра, Значение) И ЗначениеЗаполнено(Значение) Тогда
		Параметры.Вставить(ИмяПараметра, Строка(Значение));
	КонецЕсли;

КонецПроцедуры

Процедура СкопироватьЧисловойПараметр(Параметры, Источник, ИмяПараметра, Минимум, Максимум)

	Значение = Неопределено;
	Если Не Источник.Свойство(ИмяПараметра, Значение) Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ЧислоПараметра = Число(Значение);
	Исключение
		Возврат;
	КонецПопытки;

	Если ЧислоПараметра >= Минимум И ЧислоПараметра <= Максимум Тогда
		Параметры.Вставить(ИмяПараметра, ЧислоПараметра);
	КонецЕсли;

КонецПроцедуры

Функция КлючФоновогоЗадания()

	Возврат "Мсп_СерверныйКаналСервер.ПоддержатьКанал";

КонецФункции

Функция ДругоеАктивноеЗаданиеСКлючом(Ключ)

	Отбор = Новый Структура("Ключ, Состояние", Ключ, СостояниеФоновогоЗадания.Активно);
	Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);

	// Внутри текущего регламентного задания платформа уже видит один активный тик.
	Возврат Задания.Количество() > 1;

КонецФункции

Функция ПодключитьКомпоненту()

	Подключено = ПодключитьВнешнююКомпоненту(
		"ОбщийМакет.Мсп_webTransport",
		"WebTransport",
		ТипВнешнейКомпоненты.Native);
	Если Не Подключено Тогда
		ВызватьИсключение НСтр("ru='Не удалось подключить WebTransport из ОбщийМакет.Мсп_webTransport'");
	КонецЕсли;

	Возврат Новый("AddIn.WebTransport.session");

КонецФункции

Процедура НастроитьЛогированиеКомпоненты(Компонента, УровеньЛогирования)

	Если Не ЗначениеЗаполнено(УровеньЛогирования) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Компонента.НастроитьЛогирование(УровеньЛогирования);
	Исключение
		ЗаписатьВЖР("LogLevel", "не удалось применить " + УровеньЛогирования + ": " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Процедура ЗапуститьИнтеграцию(Компонента, Параметры)

	Запущено = Компонента.ЗапуститьСессионнуюИнтеграцию(
		Параметры.manager_url,
		Параметры.client_uid,
		Параметры.kind,
		Параметры.corr_id);

	Если Не Запущено Тогда
		ВызватьИсключение НСтр("ru='WebTransport не запустил session-интеграцию'");
	КонецЕсли;

КонецПроцедуры

Процедура ОтправитьSessionRegister(Компонента, Параметры, Реестр)

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("client_uid", Параметры.client_uid);
	ПараметрыРегистрации.Вставить("kind", Параметры.kind);
	ПараметрыРегистрации.Вставить("version", "1.0");
	ПараметрыРегистрации.Вставить("tools", СобратьWireИнструменты(Реестр));
	ПараметрыРегистрации.Вставить("infobase_name", Мсп_ИдентификацияСессии.ИмяИнформационнойБазы());
	ПараметрыРегистрации.Вставить("ib_session_number", Мсп_ИдентификацияСессии.НомерСеансаКлиента());

	HostID = HostIDСервера();
	Если ЗначениеЗаполнено(HostID) Тогда
		ПараметрыРегистрации.Вставить("host_id", HostID);
	КонецЕсли;

	Сообщение = Новый Структура;
	Сообщение.Вставить("jsonrpc", "2.0");
	Сообщение.Вставить("id", "reg-server-1");
	Сообщение.Вставить("method", "session.register");
	Сообщение.Вставить("params", ПараметрыРегистрации);

	Если Не ОтправитьСообщение(Компонента, Сообщение) Тогда
		ВызватьИсключение НСтр("ru='Не удалось отправить session.register серверного канала'");
	КонецЕсли;

	ЗаписатьВЖР("Register", "tools=" + Строка(ПараметрыРегистрации.tools.Количество()));

КонецПроцедуры

Функция СобратьWireИнструменты(Реестр)

	Инструменты = Новый Массив;
	Для Каждого ОписаниеИнструмента Из Мсп_РеестрСервер.Инструменты(Реестр) Цикл
		WireДескриптор = Новый Структура;
		WireДескриптор.Вставить("name", ОписаниеИнструмента.Имя);
		Если ЗначениеЗаполнено(ОписаниеИнструмента.Описание) Тогда
			WireДескриптор.Вставить("description", ОписаниеИнструмента.Описание);
		КонецЕсли;
		WireДескриптор.Вставить("input_schema", ОписаниеИнструмента.СхемаПараметров);
		Инструменты.Добавить(WireДескриптор);
	КонецЦикла;

	Возврат Инструменты;

КонецФункции

Функция HostIDСервера()

	Попытка
		СистемнаяИнформация = Новый СистемнаяИнформация();
		Возврат Строка(СистемнаяИнформация.ИдентификаторКлиента);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Процедура ЦиклPolling(Компонента, Реестр, Параметры)

	ДатаОкончания = ТекущаяДатаСеанса() + Параметры.tick_seconds;

	Пока ТекущаяДатаСеанса() < ДатаОкончания Цикл
		Если КаналРазорван(Компонента) Тогда
			ЗаписатьВЖР("PollStop", "компонента сообщила о разрыве канала");
			Прервать;
		КонецЕсли;

		ТекстСообщения = Компонента.ПолучитьСообщение(Параметры.poll_timeout_ms);
		Если Не ЗначениеЗаполнено(ТекстСообщения) Тогда
			Продолжить;
		КонецЕсли;

		ОбработатьВходящееСообщение(Компонента, Реестр, ТекстСообщения);
	КонецЦикла;

КонецПроцедуры

Функция КаналРазорван(Компонента)

	Состояние = СостояниеКомпоненты(Компонента);
	Если Не ЗначениеЗаполнено(Состояние) Тогда
		Возврат Ложь;
	КонецЕсли;

	Состояние = НРег(Состояние);
	Возврат Состояние = "closed"
		Или Состояние = "disconnected"
		Или Состояние = "give_up"
		Или Состояние = "failed"
		Или Состояние = "stopped";

КонецФункции

Функция СостояниеКомпоненты(Компонента)

	Результат = ПолучитьСостояниеКомпоненты(Компонента);
	Если Результат.Доступно Тогда
		Возврат Результат.Состояние;
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПолучитьСостояниеКомпоненты(Компонента)

	Результат = Новый Структура("Доступно, Состояние, Ошибка", Ложь, "", "");

	Попытка
		Состояние = Компонента.ПолучитьСостояние();
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Результат.Доступно = Истина;
		Результат.Состояние = Свойство(Состояние, "state", "");
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Состояние) = Тип("Строка") И СтрНачинаетсяС(СокрЛП(Состояние), "{") Тогда
		РазобранноеСостояние = НормализоватьЗначение(ПрочитатьJSONСтрокуБезОшибок(Состояние, Неопределено));
		Если ТипЗнч(РазобранноеСостояние) = Тип("Структура") Тогда
			Результат.Доступно = Истина;
			Результат.Состояние = Свойство(РазобранноеСостояние, "state", "");
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Результат.Доступно = Истина;
	Результат.Состояние = Строка(Состояние);
	Возврат Результат;

КонецФункции

Функция НормализоватьТаймаутПроверки(ТаймаутМс)

	Попытка
		Таймаут = Число(ТаймаутМс);
	Исключение
		Таймаут = 3000;
	КонецПопытки;

	Если Таймаут < 100 Тогда
		Возврат 100;
	КонецЕсли;

	Если Таймаут > 60000 Тогда
		Возврат 60000;
	КонецЕсли;

	Возврат Таймаут;

КонецФункции

Процедура ОжидатьДоступностьМенеджера(Компонента, Результат, НачалоПроверки, ТаймаутПроверкиМс)

	ШагОжиданияМс = 100;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоПроверки < ТаймаутПроверкиМс Цикл
		Состояние = ПолучитьСостояниеКомпоненты(Компонента);
		Результат.state = Состояние.Состояние;
		Если Не Состояние.Доступно Тогда
			Результат.error = "WebTransport session не предоставляет состояние соединения: " + Состояние.Ошибка;
			Возврат;
		КонецЕсли;

		Если СостояниеМенеджераДоступно(Состояние.Состояние) Тогда
			Результат.ok = Истина;
			Возврат;
		КонецЕсли;

		Если КаналРазорван(Компонента) Тогда
			Результат.error = "WebTransport session сообщил о разрыве канала";
			Возврат;
		КонецЕсли;

		Попытка
			Компонента.ПолучитьСообщение(ШагОжиданияМс);
		Исключение
			Результат.error = "WebTransport session не предоставляет polling ожидание: " + ОписаниеОшибки();
			Возврат;
		КонецПопытки;
	КонецЦикла;

	Результат.error = "Истек таймаут проверки доступности manager_url";

КонецПроцедуры

Функция СостояниеМенеджераДоступно(Состояние)

	Состояние = НРег(СокрЛП(Состояние));
	Возврат Состояние = "connected";

КонецФункции

Процедура ОбработатьВходящееСообщение(Компонента, Реестр, ТекстСообщения)

	Сообщение = ПрочитатьJSONСтрокуБезОшибок(ТекстСообщения, Неопределено);
	Сообщение = НормализоватьЗначение(Сообщение);
	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		ЗаписатьВЖР("IncomingSkip", "не JSON-объект");
		Возврат;
	КонецЕсли;

	Сообщение = РазвернутьКонвертЕслиНужно(Сообщение);
	Метод = Свойство(Сообщение, "method", "");
	Идентификатор = Свойство(Сообщение, "id", "");

	Если Не ЗначениеЗаполнено(Метод) Тогда
		Возврат;
	КонецЕсли;

	Параметры = Свойство(Сообщение, "params", Новый Структура);
	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Параметры = Новый Структура;
	КонецЕсли;

	Если Метод = "tool.call" Тогда
		ВыполнитьToolCall(Компонента, Реестр, Идентификатор, Параметры);
	ИначеЕсли Метод = "ping" Тогда
		ОтправитьСообщение(Компонента, Новый Структура("jsonrpc, id, result", "2.0", Идентификатор, Новый Структура));
	ИначеЕсли Метод = "session.shutdown" Тогда
		ОтправитьSessionShutdown(Компонента, Идентификатор, Параметры);
	Иначе
		ОтправитьСообщение(Компонента, ОтветМетодНеНайден(Идентификатор, Метод));
	КонецЕсли;

КонецПроцедуры

Функция РазвернутьКонвертЕслиНужно(Сообщение)

	ПолезнаяНагрузка = Свойство(Сообщение, "payload", Неопределено);
	Если ПолезнаяНагрузка = Неопределено Или Свойство(Сообщение, "method", Неопределено) <> Неопределено Тогда
		Возврат Сообщение;
	КонецЕсли;

	Если ТипЗнч(ПолезнаяНагрузка) <> Тип("Строка") Или Не ЗначениеЗаполнено(ПолезнаяНагрузка) Тогда
		Возврат Сообщение;
	КонецЕсли;

	Развернутое = НормализоватьЗначение(ПрочитатьJSONСтрокуБезОшибок(ПолезнаяНагрузка, Неопределено));
	Если ТипЗнч(Развернутое) = Тип("Структура") Тогда
		Возврат Развернутое;
	КонецЕсли;

	Возврат Сообщение;

КонецФункции

Процедура ВыполнитьToolCall(Компонента, Реестр, Идентификатор, Параметры)

	ИмяИнструмента = Свойство(Параметры, "name", "");
	Аргументы = Свойство(Параметры, "arguments", Новый Структура);
	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Аргументы = Новый Структура;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИмяИнструмента) Тогда
		ОтправитьСообщение(Компонента, ОтветОшибка(Идентификатор, -32602, "tool.call params.name is required"));
		Возврат;
	КонецЕсли;

	Попытка
		РезультатВыполнения = Мсп_СерверСервер.ВыполнитьИнструмент(Реестр, ИмяИнструмента, Аргументы);
	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		ОтправитьСообщение(Компонента, ОтветОшибка(
			Идентификатор,
			-32603,
			ПодробноеПредставлениеОшибки(ИнфоОшибки)));
		Возврат;
	КонецПопытки;

	ОтправитьСообщение(Компонента, ОтветToolCall(Идентификатор, РезультатВыполнения));

КонецПроцедуры

Функция ОтветToolCall(Идентификатор, РезультатВыполнения)

	Если ТипЗнч(РезультатВыполнения) = Тип("Структура")
		И РезультатВыполнения.Свойство("Успех")
		И Не РезультатВыполнения.Успех Тогда
		Возврат ОтветОшибка(Идентификатор, -32603, РезультатВыполнения.Ошибка);
	КонецЕсли;

	Данные = РезультатВыполнения;
	Если ТипЗнч(РезультатВыполнения) = Тип("Структура")
		И РезультатВыполнения.Свойство("Успех")
		И РезультатВыполнения.Свойство("Данные") Тогда
		Данные = РезультатВыполнения.Данные;
	КонецЕсли;

	ToolCallResult = Новый Структура;
	ToolCallResult.Вставить("content", Новый Массив);
	ToolCallResult.content.Добавить(Новый Структура("type, text", "text", Сериализовать(Данные)));

	Возврат Новый Структура("jsonrpc, id, result", "2.0", Идентификатор, ToolCallResult);

КонецФункции

Процедура ОтправитьSessionShutdown(Компонента, Идентификатор, Параметры)

	Если ЗначениеЗаполнено(Идентификатор) Тогда
		ОтправитьСообщение(Компонента, Новый Структура("jsonrpc, id, result", "2.0", Идентификатор, Новый Структура));
	КонецЕсли;

	Причина = Свойство(Параметры, "reason", "manager_shutdown");
	Bye = Новый Структура;
	Bye.Вставить("jsonrpc", "2.0");
	Bye.Вставить("method", "session.bye");
	Bye.Вставить("params", Новый Структура("reason", Причина));
	ОтправитьСообщение(Компонента, Bye);

КонецПроцедуры

Функция ОтветМетодНеНайден(Идентификатор, Метод)

	Возврат ОтветОшибка(Идентификатор, -32601, "Method not found: " + Метод);

КонецФункции

Функция ОтветОшибка(Идентификатор, КодОшибки, СообщениеОшибки)

	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("error", Новый Структура("code, message", КодОшибки, СообщениеОшибки));
	Возврат Ответ;

КонецФункции

Функция ОтправитьСообщение(Компонента, Сообщение)

	Попытка
		Возврат Компонента.ОтправитьСообщение(Сериализовать(Сообщение));
	Исключение
		ЗаписатьВЖР("SendError", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Процедура ОстановитьКомпоненту(Компонента)

	Если Компонента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Компонента.ОстановитьСессионнуюИнтеграцию();
	Исключение
	КонецПопытки;

КонецПроцедуры

Функция ПрочитатьJSONСтрокуБезОшибок(ТекстJSON, ЗначениеПоУмолчанию)

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстJSON);
		Возврат ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
		ЗаписатьВЖР("ParseError", Лев(?(ТекстJSON = Неопределено, "", Строка(ТекстJSON)), 200));
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;

КонецФункции

Функция Сериализовать(Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция Свойство(Объект, ИмяСвойства, ЗначениеПоУмолчанию)

	Значение = ЗначениеПоУмолчанию;
	Если ТипЗнч(Объект) = Тип("Структура") И Объект.Свойство(ИмяСвойства, Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция НормализоватьЗначение(Значение)

	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат СоответствиеВСтруктуру(Значение);
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(НормализоватьЗначение(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция СоответствиеВСтруктуру(Соответствие)

	Результат = Новый Структура;
	Для Каждого КлючЗначение Из Соответствие Цикл
		Ключ = Строка(КлючЗначение.Ключ);
		Если ЗначениеЗаполнено(Ключ) Тогда
			Результат.Вставить(Ключ, НормализоватьЗначение(КлючЗначение.Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаписатьВЖР(Событие, Сообщение, Уровень = Неопределено)

	Если Уровень = Неопределено Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;

	Попытка
		ЗаписьЖурналаРегистрации(
			"Мсп.СерверныйКанал." + Событие,
			Уровень,
			,
			,
			Строка(Сообщение));
	Исключение
	КонецПопытки;

КонецПроцедуры

