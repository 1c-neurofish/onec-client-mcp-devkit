#Область ПрограммныйИнтерфейс

// Строит серверный реестр hub через provider-подсистемы *_Мсп_СерверныеПровайдеры.
//
// Возвращаемое значение:
//  Структура - аккумулятор Мсп_РеестрСервер.НовыйРеестр().
Функция ПостроитьРеестр() Экспорт

	Реестр = Мсп_РеестрСервер.НовыйРеестр();
	ЗарегистрироватьПровайдеров(Реестр);

	Возврат Реестр;

КонецФункции

// Регистрирует серверных провайдеров в переданный реестр.
//
// Параметры:
//  Реестр - Структура - аккумулятор Мсп_РеестрСервер.НовыйРеестр().
Процедура ЗарегистрироватьПровайдеров(Реестр) Экспорт

	Для Каждого ОписаниеПровайдера Из Провайдеры() Цикл
		ЗарегистрироватьПровайдера(Реестр, ОписаниеПровайдера);
	КонецЦикла;

КонецПроцедуры

// Возвращает серверных провайдеров, найденных по отдельной серверной маске.
//
// Возвращаемое значение:
//  Массив - элементы Структура(Имя, Тип).
Функция Провайдеры() Экспорт

	Результат = Новый Массив;

	Для Каждого Подсистема Из Мсп_МетаданныеСервер.ПодсистемыСерверныхПровайдеров() Цикл
		ДобавитьПровайдеровПодсистемы(Результат, Подсистема);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает provider-подсистемы серверного extension-point.
//
// Возвращаемое значение:
//  Массив - подсистемы с именем *_Мсп_СерверныеПровайдеры.
Функция ПодсистемыСерверныхПровайдеров() Экспорт

	Возврат Мсп_МетаданныеСервер.ПодсистемыСерверныхПровайдеров();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПровайдеровПодсистемы(Результат, Подсистема)

	Для Каждого ОбъектМетаданных Из Подсистема.Состав Цикл
		Если Метаданные.ОбщиеМодули.Содержит(ОбъектМетаданных) Тогда
			Результат.Добавить(НовыйОписаниеПровайдера(ОбъектМетаданных.Имя, "ОбщийМодуль"));
		ИначеЕсли Метаданные.Обработки.Содержит(ОбъектМетаданных) Тогда
			Результат.Добавить(НовыйОписаниеПровайдера(ОбъектМетаданных.Имя, "Обработка"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗарегистрироватьПровайдера(Реестр, ОписаниеПровайдера)

	Если ОписаниеПровайдера.Тип <> "ОбщийМодуль" Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru='Серверный провайдер с типом ""%1"" не поддерживается'"),
			ОписаниеПровайдера.Тип);
	КонецЕсли;

	МодульПровайдера = МодульПровайдера(ОписаниеПровайдера);
	МодульПровайдера.ЗарегистрироватьСерверные(Реестр);

КонецПроцедуры

Функция МодульПровайдера(ОписаниеПровайдера)

	Попытка
		Возврат Вычислить(ОписаниеПровайдера.Имя);
	Исключение
		ИнфоОшибки = ИнформацияОбОшибке();
		ВызватьИсключение СтрШаблон(
			НСтр("ru='Не удалось получить серверный провайдер ""%1"": %2'"),
			ОписаниеПровайдера.Имя,
			ПодробноеПредставлениеОшибки(ИнфоОшибки));
	КонецПопытки;

КонецФункции

Функция НовыйОписаниеПровайдера(Имя, Тип)

	ОписаниеПровайдера = Новый Структура;
	ОписаниеПровайдера.Вставить("Имя", Имя);
	ОписаниеПровайдера.Вставить("Тип", Тип);

	Возврат ОписаниеПровайдера;

КонецФункции

#КонецОбласти
