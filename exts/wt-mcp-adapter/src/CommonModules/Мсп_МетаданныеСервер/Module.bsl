// Возвращает provider-подсистемы серверного extension-point.
//
// Возвращаемое значение:
//  Массив - подсистемы с именем *_Мсп_СерверныеПровайдеры.
Функция ПодсистемыСерверныхПровайдеров() Экспорт

	ИмяПодсистемы = "Мсп_СерверныеПровайдеры";
	Результат = Новый Массив;

	БазоваяПодсистема = Метаданные.Подсистемы.Найти(ИмяПодсистемы);
	Если БазоваяПодсистема <> Неопределено Тогда
		Результат.Добавить(БазоваяПодсистема);
	КонецЕсли;

	Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
		Если Подсистема.ВключатьВКомандныйИнтерфейс Тогда
			Продолжить;
		КонецЕсли;

		Если СтрЗаканчиваетсяНа(Подсистема.Имя, "_" + ИмяПодсистемы) Тогда
			Результат.Добавить(Подсистема);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции
//++agent TASK-202

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПровайдеровПодсистемы(Результат, Подсистема)

	Для Каждого ОбъектМетаданных Из Подсистема.Состав Цикл
		Если Метаданные.ОбщиеМодули.Содержит(ОбъектМетаданных) Тогда
			Результат.Добавить(НовыйОписаниеПровайдера(ОбъектМетаданных.Имя, "ОбщийМодуль"));
		ИначеЕсли Метаданные.Обработки.Содержит(ОбъектМетаданных) Тогда
			Результат.Добавить(НовыйОписаниеПровайдера(ОбъектМетаданных.Имя, "Обработка"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПодсистемыПровайдеров()

	ИмяПодсистемы = "Мсп_Провайдеры";
	Результат = Новый Массив;
	БазоваяПодсистема = Метаданные.Подсистемы[ИмяПодсистемы];
	Если БазоваяПодсистема <> Неопределено Тогда
		Результат.Добавить(БазоваяПодсистема);
	КонецЕсли;

	Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
		Если Подсистема.ВключатьВКомандныйИнтерфейс Тогда
			Продолжить;
		КонецЕсли;

		Если СтрЗаканчиваетсяНа(Подсистема.Имя, "_" + ИмяПодсистемы) Тогда
			Результат.Добавить(Подсистема);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Конструктор описания провайдера.
//
// Параметры:
//  Имя - Строка - Имя провайдера.
//  Тип - Строка - Тип провайдера (ОбщийМодуль, Обработка).
//
// Возвращаемое значение:
//  Структура - Описание провайдера:
//   * Имя - Строка - Имя провайдера.
//   * Тип - Строка - Тип провайдера.
Функция НовыйОписаниеПровайдера(Имя, Тип)
	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Тип", Тип);
	Возврат Описание;
КонецФункции

// Серверная диагностическая запись в Журнал Регистрации.
// Используется клиентом для трейса без передачи контекста.
// Помещает свежий bundle компоненты во временное хранилище и возвращает адрес.
// Используется клиентом, чтобы обойти кэш ExtCompT — bundle берётся напрямую из БД,
// гарантируя актуальную версию.
//
// Возвращаемое значение:
//  Строка - Адрес во временном хранилище.
Функция АдресМакетаКомпоненты() Экспорт
	Макет = ПолучитьОбщийМакет("Мсп_webTransport");
	Возврат ПоместитьВоВременноеХранилище(Макет, Новый УникальныйИдентификатор());
КонецФункции

Процедура ЗаписатьСобытиеВЖР(ИмяСобытия, Сообщение) Экспорт
	Попытка
		ЗаписьЖурналаРегистрации(
			Строка(ИмяСобытия),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			Строка(Сообщение));
	Исключение
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
