#Область ПрограммныйИнтерфейс

Функция Провайдеры() Экспорт

	Результат = Новый Массив;

	Для Каждого Подсистема Из ПодсистемыПровайдеров() Цикл
		ДобавитьПровайдеровПодсистемы(Результат, Подсистема);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает сведения об информационной базе.
//
// Возвращаемое значение:
//  Структура - Сведения об информационной базе:
//   * Платформа - Структура - Версия и ТипПлатформы.
//   * Конфигурация - Структура - Имя и Версия.
//   * ВстроенныйЯзык - Строка - Код встроенного языка (ru, en).
//   * ФайловаяБаза - Булево.
//   * Расширения - Массив - Описания установленных расширений.
//   * РасширенияДоступны - Булево - Ложь, если расширения не удалось получить.
Функция ИнформацияИБ() Экспорт

	СистемнаяИнформация = Новый СистемнаяИнформация();

	Информация = Новый Структура;
	Информация.Вставить("Платформа", НовыйОписаниеПлатформы(
		СистемнаяИнформация.ВерсияПриложения,
		Строка(СистемнаяИнформация.ТипПлатформы)));
	Информация.Вставить("Конфигурация", НовыйОписаниеКонфигурации(
		Метаданные.Представление(),
		Метаданные.Версия));
	Информация.Вставить("ВстроенныйЯзык", ВстроенныйЯзык());
	Информация.Вставить("ФайловаяБаза", ЭтоФайловаяБаза());

	Расширения = ПолучитьРасширенияКонфигурации();
	Информация.Вставить("Расширения", Расширения.Список);
	Информация.Вставить("РасширенияДоступны", Расширения.Доступны);

	Возврат Информация;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПровайдеровПодсистемы(Результат, Подсистема)

	Для Каждого ОбъектМетаданных Из Подсистема.Состав Цикл
		Если Метаданные.ОбщиеМодули.Содержит(ОбъектМетаданных) Тогда
			Результат.Добавить(НовыйОписаниеПровайдера(ОбъектМетаданных.Имя, "ОбщийМодуль"));
		ИначеЕсли Метаданные.Обработки.Содержит(ОбъектМетаданных) Тогда
			Результат.Добавить(НовыйОписаниеПровайдера(ОбъектМетаданных.Имя, "Обработка"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПодсистемыПровайдеров()

	ИмяПодсистемы = "Мсп_Провайдеры";
	Результат = Новый Массив;
	БазоваяПодсистема = Метаданные.Подсистемы[ИмяПодсистемы];
	Если БазоваяПодсистема <> Неопределено Тогда
		Результат.Добавить(БазоваяПодсистема);
	КонецЕсли;

	Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
		Если Подсистема.ВключатьВКомандныйИнтерфейс Тогда
			Продолжить;
		КонецЕсли;

		Если СтрЗаканчиваетсяНа(Подсистема.Имя, "_" + ИмяПодсистемы) Тогда
			Результат.Добавить(Подсистема);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Конструктор описания провайдера.
//
// Параметры:
//  Имя - Строка - Имя провайдера.
//  Тип - Строка - Тип провайдера (ОбщийМодуль, Обработка).
//
// Возвращаемое значение:
//  Структура - Описание провайдера:
//   * Имя - Строка - Имя провайдера.
//   * Тип - Строка - Тип провайдера.
Функция НовыйОписаниеПровайдера(Имя, Тип)
	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Тип", Тип);
	Возврат Описание;
КонецФункции

Функция НовыйОписаниеПлатформы(Версия, ТипПлатформы)
	Описание = Новый Структура;
	Описание.Вставить("Версия", Версия);
	Описание.Вставить("ТипПлатформы", ТипПлатформы);
	Возврат Описание;
КонецФункции

Функция НовыйОписаниеКонфигурации(Имя, Версия)
	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Версия", Версия);
	Возврат Описание;
КонецФункции

Функция ВстроенныйЯзык()
	ЭтоРусскийВстроенныйЯзык = Метаданные.ВариантВстроенногоЯзыка = Метаданные.СвойстваОбъектов.ВариантВстроенногоЯзыка.Русский;
	Возврат Формат(ЭтоРусскийВстроенныйЯзык, "БЛ=en; БИ=ru;");
КонецФункции

Функция ЭтоФайловаяБаза()
	Возврат СтрНайти(Врег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1;
КонецФункции

Функция ПолучитьРасширенияКонфигурации()
	Результат = НовыйРезультатРасширений();
	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Результат.Список.Добавить(НовыйОписаниеРасширения(Расширение));
		КонецЦикла;
	Исключение
		Результат.Доступны = Ложь;
	КонецПопытки;

	Возврат Результат;
КонецФункции

Функция НовыйРезультатРасширений()
	Результат = Новый Структура;
	Результат.Вставить("Доступны", Истина);
	Результат.Вставить("Список", Новый Массив);
	Возврат Результат;
КонецФункции

Функция НовыйОписаниеРасширения(Расширение)
	Описание = Новый Структура;
	Описание.Вставить("Имя", Расширение.Имя);
	Описание.Вставить("Версия", Расширение.Версия);
	Описание.Вставить("БезопасныйРежим", Расширение.БезопасныйРежим);
	Описание.Вставить("ЗащитаОтОпасныхДействий",
		Строка(Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях));
	Возврат Описание;
КонецФункции

#КонецОбласти
