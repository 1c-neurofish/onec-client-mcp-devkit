		Мсп_ЛогированиеКлиент.Важно("УведомитьОбИзмененииРесурсов ignored: Компонента is undefined");
		Возврат Истина;
	КонецЕсли;

	Попытка
		Ждать Компонента.УведомитьОбИзмененииРесурсовАсинх();
	Исключение
		Мсп_ЛогированиеКлиент.Ошибка(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Истина;
КонецФункции

