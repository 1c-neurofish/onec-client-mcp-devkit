#Область ПрограммныйИнтерфейс

// Отправляет notifications/tools/list_changed всем подключённым клиентам.
//
// Возвращаемое значение:
//  Булево - Истина.
Асинх Функция УведомитьОбИзмененииИнструментов() Экспорт
	// В WS-режиме менеджер сессий ждёт session.tools_changed с актуальным
	// списком инструментов (см. v8-client-session-manager/protocol.rs::SESSION_TOOLS_CHANGED).
	// Diff-gate в SessionRegistry::update_tools решает, будить ли AI.
	Если РежимТранспортаWS() Тогда
		Мсп_ТранспортСессионКлиент.ОтправитьИзменениеИнструментов();
		Возврат Истина;
	КонецЕсли;

	// Server-mode: уведомить компоненту-mcp-сервер; она сама пробросит
	// notifications/tools/list_changed подключённым AI-клиентам.
	Компонента = ЭкземплярСервера();
	Если Компонента = Неопределено Тогда
		Мсп_ЛогированиеКлиент.Важно("УведомитьОбИзмененииИнструментов ignored: Компонента is undefined");
		Возврат Истина;
	КонецЕсли;

	Попытка
		Ждать Компонента.УведомитьОбИзмененииИнструментовАсинх();
	Исключение
		Мсп_ЛогированиеКлиент.Ошибка(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Истина;
КонецФункции

