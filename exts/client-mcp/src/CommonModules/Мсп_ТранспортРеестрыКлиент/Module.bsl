		Мсп_ЛогированиеКлиент.Информация("WS: УведомитьОбИзмененииРесурсов — менеджер ещё не ловит resources, пропуск");
		Возврат Истина;
	КонецЕсли;

	Компонента = ЭкземплярСервера();
