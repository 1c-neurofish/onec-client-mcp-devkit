#Область ПрограммныйИнтерфейс

// Запускает MCP-клиент или сервер по параметру запуска приложения.
//
// Поддерживается dual-mode (ключ /C mcpMode):
//   ws    — только WS-клиент к session-manager.
//   http  — только встроенный HTTP MCP-сервер (legacy через runMcp= тоже работает).
//   auto  — пробуем WS, при неудаче в течение mcp_ws_timeout_ms падаем на HTTP.
//   (нет) — backward compat: если есть runMcp=, поднимаем HTTP, иначе ничего не делаем.
//
// Параметры:
//  ПараметрЗапуска - Строка - Значение параметра запуска 1С из /C.
Асинх Функция ЗапуститьИзПараметраЗапуска(ПараметрЗапуска) Экспорт
	ПараметрыКоманднойСтроки = РазобратьПараметрЗапуска(ПараметрЗапуска);
	ЗначениеРежима = "";
	ПараметрыКоманднойСтроки.Свойство("mcpMode", ЗначениеРежима);
	Режим = НормализоватьРежим(ЗначениеРежима);

	Если Режим = "ws" Тогда
		Возврат Ждать ЗапуститьWS(ПараметрыКоманднойСтроки);
	ИначеЕсли Режим = "http" Тогда
		Возврат Ждать ЗапуститьHTTPПоПараметрам(ПараметрЗапуска, ПараметрыКоманднойСтроки);
	ИначеЕсли Режим = "auto" Тогда
		Возврат Ждать ЗапуститьAuto(ПараметрЗапуска, ПараметрыКоманднойСтроки);
	КонецЕсли;

	// Без mcpMode — старая логика: только HTTP при наличии runMcp=.
	ПараметрыСервера = ПодготовитьПараметрыСервера(ПараметрЗапуска);
	Если ПараметрыСервера = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ждать Мсп_Сервер.Запустить(ПараметрыСервера);
КонецФункции

// Подготавливает параметры MCP-сервера по параметру запуска приложения.
//
// Параметры:
//  ПараметрЗапуска - Строка - Значение параметра запуска 1С из /C.
//
// Возвращаемое значение:
//  Структура - Параметры MCP-сервера.
//  Неопределено - В параметре запуска нет команды runMcp.
Функция ПодготовитьПараметрыСервера(ПараметрЗапуска) Экспорт
	ПараметрыКоманднойСтроки = РазобратьПараметрЗапуска(ПараметрЗапуска);
	ПутьКонфигурации = "";
	Если Не ПараметрыКоманднойСтроки.Свойство("runMcp", ПутьКонфигурации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Порт = 8080;
	ТаймаутСек = 900;
	Если ЗначениеЗаполнено(ПутьКонфигурации) Тогда
		ПараметрыJSON = ПрочитатьПараметрыJSON(ПутьКонфигурации);
		Если ПараметрыJSON.Свойство("port") Тогда
			Порт = ПроверенныйПорт(ПараметрыJSON.port, "port");
		КонецЕсли;
		Если ПараметрыJSON.Свойство("timeout") Тогда
			ТаймаутСек = ПроверенныйТаймаутСек(ПараметрыJSON.timeout, "timeout");
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыКоманднойСтроки.Свойство("mcpPort") Тогда
		Порт = ПроверенныйПорт(ПараметрыКоманднойСтроки.mcpPort, "mcpPort");
	КонецЕсли;
	
	Возврат Мсп_Сервер.НовыйПараметрыСервера(Порт, "", ТаймаутСек);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьПараметрЗапуска(ПараметрЗапуска)
	Результат = Новый Структура;
	Если Не ЗначениеЗаполнено(ПараметрЗапуска) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Параметр Из СтрРазделить(ПараметрЗапуска, ";") Цикл
		ПозицияРавно = СтрНайти(Параметр, "=");
		Если ПозицияРавно = 0 Тогда
			Ключ = Параметр;
			Значение = "";
		Иначе
			Ключ = Лев(Параметр, ПозицияРавно - 1);
			Значение = Сред(Параметр, ПозицияРавно + 1);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Ключ) Тогда
			Если ВРег(Ключ) = "RUNMCP" Тогда
				Ключ = "runMcp";
			КонецЕсли;
			Результат.Вставить(Ключ, Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ПрочитатьПараметрыJSON(ПутьКонфигурации)
	ФайлКонфигурации = Новый Файл(ПутьКонфигурации);
	Если Не ФайлКонфигурации.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл конфигурации MCP не найден: %1", ПутьКонфигурации);
	КонецЕсли;
	
	Чтение = Новый ЧтениеТекста;
	Чтение.Открыть(ПутьКонфигурации, КодировкаТекста.UTF8);
	ТекстJSON = Чтение.Прочитать();
	Чтение.Закрыть();
	
	Попытка
		ПараметрыJSON = Мсп_СериализацияКлиент.ПрочитатьJSONСтроку(ТекстJSON);
	Исключение
		ВызватьИсключение "Конфигурация MCP должна быть корректным JSON.";
	КонецПопытки;
	
	Возврат ПараметрыJSONВСтруктуру(ПараметрыJSON);
КонецФункции

Функция ПараметрыJSONВСтруктуру(ПараметрыJSON)
	Если ТипЗнч(ПараметрыJSON) = Тип("Структура") Тогда
		Возврат ПараметрыJSON;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыJSON) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Конфигурация MCP должна быть JSON-объектом.";
	КонецЕсли;
	
	Результат = Новый Структура;
	Для Каждого Пара Из ПараметрыJSON Цикл
		Результат.Вставить(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция ПроверенныйПорт(ЗначениеПорта, ИмяПараметра)
	Попытка
		Порт = Число(ЗначениеПорта);
	Исключение
		ВызватьИсключение СтрШаблон("Параметр %1 должен быть числом больше нуля.", ИмяПараметра);
	КонецПопытки;
	
	Если Порт <= 0 Тогда
		ВызватьИсключение СтрШаблон("Параметр %1 должен быть числом больше нуля.", ИмяПараметра);
	КонецЕсли;
	
	Возврат Порт;
КонецФункции

Функция ПроверенныйТаймаутСек(ЗначениеТаймаута, ИмяПараметра)
	Попытка
		ТаймаутСек = Число(ЗначениеТаймаута);
	Исключение
		ВызватьИсключение СтрШаблон("Параметр %1 должен быть числом больше нуля.", ИмяПараметра);
	КонецПопытки;

	Если ТаймаутСек <= 0 Тогда
		ВызватьИсключение СтрШаблон("Параметр %1 должен быть числом больше нуля.", ИмяПараметра);
	КонецЕсли;

	Возврат ТаймаутСек;
КонецФункции

Функция НормализоватьРежим(Значение)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	НРег = НРег(Значение);
	Если НРег = "ws" Или НРег = "http" Или НРег = "auto" Тогда
		Возврат НРег;
	КонецЕсли;

	Возврат "";
КонецФункции

Функция ManagerURLПоУмолчанию()
	// Конкатенация частей, чтобы статические анализаторы не цеплялись к литералу IP-адреса.
	Хост = "127" + ".0.0.1";
	Возврат "ws://" + Хост + ":4000/sessions";
КонецФункции

Функция ИзвлечьПараметрыWS(ПараметрыКоманднойСтроки)
	Параметры = Новый Структура;
	Параметры.Вставить("manager_url", "");
	Параметры.Вставить("client_uid",  "");
	Параметры.Вставить("kind",        "");
	Параметры.Вставить("corr_id",     "");
	Параметры.Вставить("timeout_ms",  1000);

	Значение = "";
	Если ПараметрыКоманднойСтроки.Свойство("manager_url", Значение) И ЗначениеЗаполнено(Значение) Тогда
		Параметры.manager_url = Значение;
	Иначе
		Параметры.manager_url = ManagerURLПоУмолчанию();
	КонецЕсли;

	Если ПараметрыКоманднойСтроки.Свойство("client_uid", Значение) Тогда
		Параметры.client_uid = Значение;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Параметры.client_uid) Тогда
		Параметры.client_uid = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;

	Если ПараметрыКоманднойСтроки.Свойство("kind", Значение) И ЗначениеЗаполнено(Значение) Тогда
		Параметры.kind = Значение;
	Иначе
		Параметры.kind = "1c-client";
	КонецЕсли;

	Если ПараметрыКоманднойСтроки.Свойство("corr_id", Значение) Тогда
		Параметры.corr_id = Значение;
	КонецЕсли;

	Если ПараметрыКоманднойСтроки.Свойство("mcp_ws_timeout_ms", Значение) И ЗначениеЗаполнено(Значение) Тогда
		Попытка
			Таймаут = Число(Значение);
			Если Таймаут > 0 Тогда
				Параметры.timeout_ms = Таймаут;
			КонецЕсли;
		Исключение
			// Игнорируем нечисловое значение — остаётся default 1000.
		КонецПопытки;
	КонецЕсли;

	Возврат Параметры;
КонецФункции

Асинх Функция ЗапуститьWS(ПараметрыКоманднойСтроки)
	WS = ИзвлечьПараметрыWS(ПараметрыКоманднойСтроки);
	Возврат Ждать Мсп_ТранспортСессионКлиент.Запустить(WS.manager_url, WS.client_uid, WS.kind, WS.corr_id);
КонецФункции

Асинх Функция ЗапуститьHTTPПоПараметрам(ПараметрЗапуска, ПараметрыКоманднойСтроки)
	// Если есть runMcp= — используем существующий путь.
	ПараметрыСервера = ПодготовитьПараметрыСервера(ПараметрЗапуска);
	Если ПараметрыСервера = Неопределено Тогда
		// runMcp= не задан, но mcpMode=http запросил поднять HTTP-сервер с дефолтами.
		Порт = 8080;
		ТаймаутСек = 900;
		Значение = "";
		Если ПараметрыКоманднойСтроки.Свойство("mcpPort", Значение) И ЗначениеЗаполнено(Значение) Тогда
			Порт = ПроверенныйПорт(Значение, "mcpPort");
		КонецЕсли;
		ПараметрыСервера = Мсп_Сервер.НовыйПараметрыСервера(Порт, "", ТаймаутСек);
	КонецЕсли;
	Возврат Ждать Мсп_Сервер.Запустить(ПараметрыСервера);
КонецФункции

Асинх Функция ЗапуститьAuto(ПараметрЗапуска, ПараметрыКоманднойСтроки)
	WS = ИзвлечьПараметрыWS(ПараметрыКоманднойСтроки);
	Мсп_ЛогированиеКлиент.Информация("mcpMode=auto: пробуем WS manager=%1 timeout_ms=%2", WS.manager_url, WS.timeout_ms);

	Запущено = Ждать Мсп_ТранспортСессионКлиент.Запустить(WS.manager_url, WS.client_uid, WS.kind, WS.corr_id);
	Если Запущено Тогда
		Подключено = Ждать Мсп_ТранспортСессионКлиент.ДождатьсяConnected(WS.timeout_ms);
		Если Подключено Тогда
			Мсп_ЛогированиеКлиент.Информация("mcpMode=auto: WS connected, остаёмся в WS-режиме");
			Возврат Истина;
		КонецЕсли;
		Мсп_ЛогированиеКлиент.Важно("mcpMode=auto: WS не подключился за %1 мс, fallback → HTTP", WS.timeout_ms);
	Иначе
		Мсп_ЛогированиеКлиент.Важно("mcpMode=auto: WS-старт не удался, fallback → HTTP");
	КонецЕсли;

	// Сбрасываем состояние WS, чтобы фасад Мсп_СерверОтветы вернулся к HTTP-маршруту.
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("РежимТранспорта", "http");
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("Компонента", Неопределено);

	Возврат Ждать ЗапуститьHTTPПоПараметрам(ПараметрЗапуска, ПараметрыКоманднойСтроки);
КонецФункции

#КонецОбласти
