#Область ПрограммныйИнтерфейс

// Транспорт-агностичный фасад отправки JSON-RPC ответа клиенту/менеджеру.
//
// Маршрутизация идёт по ключу "РежимТранспорта" в Мсп_СостояниеКлиент:
//   "ws"   - отправка WS-фрейма через Мсп_ТранспортСессионКлиент (режим WS-клиента к session-manager).
//   "http" - отправка HTTP-ответа через Мсп_ТранспортСобытияКлиент (режим встроенного MCP HTTP-сервера).
//   Неопределено - обратная совместимость, эквивалентно "http".
//
// Вызывается из протокольного слоя (Мсп_ПротоколКлиент.*) для возврата ответа клиенту.
// HTTP-обработчики событий продолжают использовать Мсп_ТранспортСобытияКлиент.ОтправитьОтвет напрямую - фасад
// введён прежде всего для будущего WS-обработчика (Мсп_ТранспортСессионКлиент), чтобы он не дублировал
// логику маршрутизации.
//
// Параметры:
//  Идентификатор - Произвольный - JSON-RPC id запроса.
//  Ответ         - Структура    - JSON-RPC ответ (result или error).
//
// Возвращаемое значение:
//  Булево - Истина, если ответ отправлен успешно.
Асинх Функция Отправить(Идентификатор, Ответ) Экспорт
	РежимТранспорта = Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("РежимТранспорта", "http");

	Если РежимТранспорта = "ws" Тогда
		// id уже сериализуется внутри JSON-RPC ответа, отдельно его передавать не нужно -
		// параметр сохранён в сигнатуре фасада ради симметрии с HTTP-режимом.
		Возврат Мсп_ТранспортСессионКлиент.ОтправитьСообщение(Ответ);
	КонецЕсли;

	// HTTP-режим (default) - делегируем существующей реализации.
	Возврат Ждать Мсп_ТранспортСобытияКлиент.ОтправитьОтвет(Идентификатор, Ответ);
КонецФункции

#КонецОбласти
