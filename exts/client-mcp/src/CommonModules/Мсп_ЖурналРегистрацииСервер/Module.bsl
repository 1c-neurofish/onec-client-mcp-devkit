#Область ПрограммныйИнтерфейс

// Записывает ошибку в журнал регистрации.
//
// Параметры:
//  ИмяСобытия - Строка - Имя события журнала регистрации. Не должно содержать
//               зарезервированные платформой сочетания "_$" и "$_".
//  Комментарий - Строка - Текст ошибки.
Процедура ЗаписатьОшибку(ИмяСобытия, Комментарий) Экспорт
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , Комментарий);
КонецПроцедуры

#КонецОбласти
