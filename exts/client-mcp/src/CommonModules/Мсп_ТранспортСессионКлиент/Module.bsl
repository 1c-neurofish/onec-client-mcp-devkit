#Область ПрограммныйИнтерфейс

// Запускает WS-клиента к session-manager.
//
// Подключает внешнюю компоненту WebTransport (класс session), сохраняет состояние,
// инициирует соединение. Подключение происходит асинхронно - успех подтверждается
// событием WS_RECONNECT_STATE = "connected", которое обрабатывает ОбработатьВнешнееСобытие.
//
// Параметры:
//  ManagerURL  - Строка - URL session-manager (ws://host:port/path).
//  ClientUID   - Строка - стабильный идентификатор клиента.
//  Kind        - Строка - имя клиента в namespace менеджера.
//  CorrID      - Строка - correlation_id для логов менеджера, может быть пустым.
//  LogLevel    - Строка - уровень логирования транспортной компоненты
//                (off|error|warn|info|debug|trace либо EnvFilter-совместимое выражение).
//                Пустая строка — оставить уровень компоненты дефолтным (info).
//
// Возвращаемое значение:
//  Булево - Истина, если компонента подключена и интеграция запущена.
//          Истина не означает "соединение установлено" - это асинхронный процесс.
Асинх Функция Запустить(ManagerURL, ClientUID, Kind, CorrID = "", LogLevel = "") Экспорт
	Мсп_ЛогированиеКлиент.Бутстрап("Транспорт.Запустить.ENTER manager=[%1] uid=[%2] kind=[%3]", ManagerURL, ClientUID, Kind);

	// Attach компоненты с install fallback.
	Попытка
		Подключено = Ждать ПодключитьКомпоненту();
	Исключение
		Мсп_ЛогированиеКлиент.Бутстрап("Транспорт.Запустить: ПодключитьКомпоненту ИСКЛ: %1", ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	Мсп_ЛогированиеКлиент.Бутстрап("Транспорт.Запустить: ПодключитьКомпоненту -> %1", Подключено);
	Если Не Подключено Тогда
		Возврат Ложь;
	КонецЕсли;

	// Получаем session-инстанс (WS-клиент) через singleton: один и тот же объект
	// addin'а переиспользуется внутри одного процесса 1С между циклами close-form →
	// open-form. Параллельные instance'ы одного addin name приводили к тому, что
	// 1С отвергал external_event для всех, кроме первого — поэтому singleton.
	Попытка
		Компонента = ПолучитьКомпоненту();
		Мсп_ЛогированиеКлиент.Бутстрап("Транспорт.Запустить: компонента получена (singleton)");
	Исключение
		Мсп_ЛогированиеКлиент.Бутстрап("Транспорт.Запустить: ПолучитьКомпоненту ИСКЛ: %1", ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	// Прокидываем уровень логирования транспортной компоненты, если он передан
	// из /C (mcp_log_level). Метод НастроитьЛогирование возвращает Истина при
	// валидном уровне; для невалидной строки и для пустой LogLevel пропускаем.
	Если ЗначениеЗаполнено(LogLevel) Тогда
		Попытка
			Применено = Компонента.НастроитьЛогирование(LogLevel);
			Мсп_ЛогированиеКлиент.Бутстрап(
				"Транспорт.Запустить: НастроитьЛогирование(%1) -> %2", LogLevel, Применено);
		Исключение
			Мсп_ЛогированиеКлиент.Бутстрап(
				"Транспорт.Запустить: НастроитьЛогирование(%1) ИСКЛ: %2", LogLevel, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	// Записываем состояние ДО старта соединения, чтобы обработчик WS_RECONNECT_STATE
	// застал валидную компоненту в момент первого "connecting".
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("Компонента", Компонента);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("РежимТранспорта", "ws");
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("ManagerURL", ManagerURL);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("ClientUID", ClientUID);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("Kind", Kind);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("Зарегистрирован", Ложь);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("WSСостояние", "");

	Попытка
		Запущено = Компонента.ЗапуститьСессионнуюИнтеграцию(ManagerURL, ClientUID, Kind, CorrID);
		Мсп_ЛогированиеКлиент.Бутстрап("Транспорт.Запустить: ЗапуститьСессионнуюИнтеграцию -> %1", Запущено);
	Исключение
		Мсп_ЛогированиеКлиент.Бутстрап("Транспорт.Запустить: ЗапуститьСессионнуюИнтеграцию ИСКЛ: %1", ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;
КонецФункции

// Ожидает достижения состояния "connected" с таймаутом.
// Используется dual-mode startup'ом для решения «WS работает / падаем на HTTP fallback».
//
// Параметры:
//  ТаймаутМс - Число - максимальное время ожидания в миллисекундах.
//
// Возвращаемое значение:
//  Булево - Истина, если состояние стало "connected" в течение таймаута.
Функция ДождатьсяConnected(ТаймаутМс) Экспорт
	// Поллинговое ожидание не используется: connected/give_up прилетает через
	// ExternEventProcessing → ОбработатьСменуСостояния → session.register.
	// Эта функция оставлена для обратной совместимости и сразу возвращает текущее состояние.
	ТаймаутМс = ?(ТаймаутМс = Неопределено, 0, ТаймаутМс);
	Состояние = Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("WSСостояние", "");
	Возврат Состояние = "connected";
КонецФункции

// Обрабатывает события addin'а WebTransport в режиме session.
//
// Параметры:
//  Источник - Строка - имя источника ("WebTransport").
//  Событие  - Строка - WS_RECONNECT_STATE | WS_INCOMING.
//  Данные   - Строка - payload события.
//
// Возвращаемое значение:
//  Булево - Истина, если событие распознано и обработано.
Асинх Функция ОбработатьВнешнееСобытие(Источник, Событие, Данные) Экспорт
	Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
		"Мсп.Транспорт.ВнешнееСобытие",
		"src=" + Строка(Источник) + " evt=" + Строка(Событие) + " data=" + Лев(Строка(Данные), 200));

	Если Источник <> "WebTransport" Тогда
		Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР("Мсп.Транспорт.ВнешнееСобытие", "skip: src != WebTransport");
		Возврат Ложь;
	КонецЕсли;

	Если Событие = "WS_RECONNECT_STATE" Тогда
		ОбработатьСменуСостояния(Данные);
		Возврат Истина;
	ИначеЕсли Событие = "WS_INCOMING" Тогда
		ОбработатьВходящееСообщение(Данные);
		Возврат Истина;
	КонецЕсли;

	Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР("Мсп.Транспорт.ВнешнееСобытие", "skip: unknown evt=" + Строка(Событие));
	Возврат Ложь;
КонецФункции

// Отправляет JSON-RPC сообщение менеджеру через WS.
// Используется фасадом Мсп_СерверОтветы для ответов протокольного слоя
// и напрямую при отправке session.register / notifications.
//
// Параметры:
//  Сообщение - Структура - готовая JSON-RPC структура (jsonrpc, id, method/result/error, params).
//
// Возвращаемое значение:
//  Булево - Истина, если компонента приняла сообщение.
Функция ОтправитьСообщение(Сообщение) Экспорт
	Компонента = Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("Компонента", Неопределено);
	Если Компонента = Неопределено Тогда
		Мсп_ЛогированиеКлиент.Важно("WS-транспорт: ОтправитьСообщение пропущено - компонента не подключена");
		Возврат Ложь;
	КонецЕсли;

	ТекстСообщения = Мсп_СериализацияКлиент.Сериализовать(Сообщение);
	Попытка
		Отправлено = Компонента.ОтправитьСообщение(ТекстСообщения);
	Исключение
		Мсп_ЛогированиеКлиент.Ошибка(
			"WS-транспорт: ошибка ОтправитьСообщение: %1",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Если Не Отправлено Тогда
		Мсп_ЛогированиеКлиент.Важно("WS-транспорт: компонента вернула Ложь при ОтправитьСообщение");
	КонецЕсли;
	Возврат Отправлено;
КонецФункции

// Отправляет менеджеру session.tools_changed с актуальным wire-списком инструментов.
// Менеджер сам решает (по diff-gate в SessionRegistry::update_tools), нужно ли
// будить AI-клиентов уведомлением notifications/tools/list_changed.
//
// Возвращаемое значение:
//  Булево - Истина, если notification отправлен.
Функция ОтправитьИзменениеИнструментов() Экспорт
	Если Не Зарегистрирован() Тогда
		Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
			"Мсп.Транспорт.ToolsChanged",
			"skip: ещё не зарегистрирован");
		Возврат Ложь;
	КонецЕсли;
	Инструменты = СобратьWireИнструменты();
	Если Инструменты = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Параметры = Новый Структура("tools", Инструменты);
	Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
		"Мсп.Транспорт.ToolsChanged",
		"send tools count=" + Строка(Инструменты.Количество()));
	Возврат ОтправитьNotification("session.tools_changed", Параметры);
КонецФункции

// Singleton-getter транспортной компоненты. Если в состоянии уже есть живой объект -
// возвращает его (и WS-интеграцию переиспользуем за счёт идемпотентного start). Если
// нет - создаёт новый и сохраняет в состояние. Один process 1cv8c должен иметь не
// более одного instance addin'а WebTransport; параллельные instance'ы приводят к
// тому, что 1С отвергает external_event для всех, кроме первого зарегистрированного.
Функция ПолучитьКомпоненту() Экспорт
	Существующая = Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("Компонента", Неопределено);
	Если Существующая <> Неопределено Тогда
		Возврат Существующая;
	КонецЕсли;
	Новая = Новый("AddIn.WebTransport.session");
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("Компонента", Новая);
	Возврат Новая;
КонецФункции

// Финализатор для BeforeExit и тестов: гасит WS-интеграцию у текущего singleton'а
// и сбрасывает ссылку в состоянии. Идемпотентен.
Процедура ОстановитьИОсвободитьКомпоненту() Экспорт
	Компонента = Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("Компонента", Неопределено);
	Если Компонента <> Неопределено Тогда
		Попытка
			Компонента.ОстановитьСессионнуюИнтеграцию();
		Исключение
			// Игнорируем — компонента могла быть уже в нерабочем состоянии.
		КонецПопытки;
	КонецЕсли;
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("Компонента", Неопределено);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("Зарегистрирован", Ложь);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("WSСостояние", "");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Асинх Функция ПодключитьКомпоненту()
	ИмяМакета = "ОбщийМакет.Мсп_webTransport";
	ИмяКомпоненты = "WebTransport";

	// Сначала пробуем подключить уже установленную версию из ExtCompT — это путь
	// без диалога подтверждения, который безопасен для свежеспавненных дочерних
	// клиентов (там UI ещё не готов и УстановитьВнешнююКомпонентуАсинх повисает).
	Подключено = Ждать ПодключитьВнешнююКомпонентуАсинх(ИмяМакета, ИмяКомпоненты, ТипВнешнейКомпоненты.Native);
	Если Подключено Тогда
		Возврат Истина;
	КонецЕсли;

	// В кэше ничего нет (или версия не подходит) — ставим из bundle.
	Попытка
		Ждать УстановитьВнешнююКомпонентуАсинх(ИмяМакета);
	Исключение
		Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
			"Мсп.Транспорт.УстановкаКомпоненты",
			"err=" + ОписаниеОшибки());
	КонецПопытки;

	Возврат Ждать ПодключитьВнешнююКомпонентуАсинх(ИмяМакета, ИмяКомпоненты, ТипВнешнейКомпоненты.Native);
КонецФункции

Асинх Процедура ОбработатьСменуСостояния(Данные)
	СтрокаДанных = СокрЛП(?(Данные = Неопределено, "", Строка(Данные)));
	Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
		"Мсп.Транспорт.StateChange",
		"raw=" + Лев(СтрокаДанных, 200));
	Состояние = "";

	Попытка
		Если СтрНачинаетсяС(СтрокаДанных, "{") Тогда
			Разобрано = Мсп_СериализацияКлиент.ПрочитатьJSONСтрокуБезОшибок(СтрокаДанных, Неопределено);
			Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
				"Мсп.Транспорт.StateChange",
				"parse type=" + Строка(ТипЗнч(Разобрано)));
			Если ТипЗнч(Разобрано) = Тип("Структура") И Разобрано.Свойство("state") Тогда
				Состояние = Разобрано.state;
			ИначеЕсли ТипЗнч(Разобрано) = Тип("Соответствие") Тогда
				Если Разобрано.Получить("state") <> Неопределено Тогда
					Состояние = Разобрано.Получить("state");
				КонецЕсли;
			КонецЕсли;
			// Fallback regex: {"state":"<value>"}
			Если Не ЗначениеЗаполнено(Состояние) Тогда
				ПозицияКлюча = СтрНайти(СтрокаДанных, """state""");
				Если ПозицияКлюча > 0 Тогда
					Хвост = Сред(СтрокаДанных, ПозицияКлюча + 7);
					ПозицияНачала = СтрНайти(Хвост, """");
					Если ПозицияНачала > 0 Тогда
						Хвост2 = Сред(Хвост, ПозицияНачала + 1);
						ПозицияКонца = СтрНайти(Хвост2, """");
						Если ПозицияКонца > 0 Тогда
							Состояние = Лев(Хвост2, ПозицияКонца - 1);
							Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
								"Мсп.Транспорт.StateChange",
								"fallback regex state=[" + Состояние + "]");
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Состояние = СтрокаДанных;
		КонецЕсли;
	Исключение
		Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
			"Мсп.Транспорт.StateChange",
			"parse ERR: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
		"Мсп.Транспорт.StateChange",
		"parsed state=[" + Строка(Состояние) + "]");
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("WSСостояние", Состояние);

	Если Состояние = "connected" Тогда
		УжеЗарегистрирован = Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("Зарегистрирован", Ложь);
		Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
			"Мсп.Транспорт.StateChange",
			"connected -> уже зарегистрирован=" + Строка(УжеЗарегистрирован));
		Если Не УжеЗарегистрирован Тогда
			ОтправитьSessionRegister();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Асинх Процедура ОтправитьSessionRegister()
	Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР("Мсп.Транспорт.SessionRegister", "ENTER");
	ClientUID = Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("ClientUID", "");
	Kind      = Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("Kind", "");
	Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
		"Мсп.Транспорт.SessionRegister",
		"uid=[" + ClientUID + "] kind=[" + Kind + "]");

	Инструменты = СобратьWireИнструменты();
	Если Инструменты = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
		"Мсп.Транспорт.SessionRegister",
		"tools count=" + Строка(Инструменты.Количество()));

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("client_uid", ClientUID);
	ПараметрыРегистрации.Вставить("kind",       Kind);
	ПараметрыРегистрации.Вставить("version",    "1.0");
	ПараметрыРегистрации.Вставить("tools",      Инструменты);

	// ADR-0029: host_id используется менеджером для маршрутизации (sticky к хосту).
	// Менеджер сравнивает host_id строкой с self.manager_host_id (gethostname() / V8_HOST_ID).
	// Поле capabilities упразднено (ADR-0003 / ADR-0005) — менеджер маршрутизирует
	// spawn/kill по имени MCP-tool в каталоге сессии (`system_spawn_1c_client` /
	// `system_kill_pid` живут в test_client как обычные tools).
	HostID = "";
	Попытка
		// КомпьютерноеИмя() — серверная, в тонком клиенте недоступна.
		// У СистемнаяИнформация нет свойства ИмяКомпьютера — приходится платформенно.
		СисИнфо = Новый СистемнаяИнформация();
		ТипПлат = СисИнфо.ТипПлатформы;
		IsWin = ТипПлат = ТипПлатформы.Windows_x86 ИЛИ ТипПлат = ТипПлатформы.Windows_x86_64;
		Если IsWin Тогда
			// COM требует снятого Безопасного режима у расширения.
			Shell = Новый COMОбъект("WScript.Shell");
			HostID = СокрЛП(Shell.ExpandEnvironmentStrings("%COMPUTERNAME%"));
		Иначе
			// Linux/macOS: пока fallback на стабильный UUID клиента.
			// На этапе c заменим на чтение `hostname` через ЗапускПриложения.
			HostID = Строка(СисИнфо.ИдентификаторКлиента);
		КонецЕсли;
	Исключение
		Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
			"Мсп.Транспорт.SessionRegister",
			"host_id ERR: " + ОписаниеОшибки());
	КонецПопытки;
	Если ЗначениеЗаполнено(HostID) Тогда
		ПараметрыРегистрации.Вставить("host_id", HostID);
	КонецЕсли;

	// ADR-0003 / ADR-0005: поле capabilities удалено из session.register.
	// Менеджер вычисляет «может ли сессия spawn'ить» по наличию tool'а
	// `system_spawn_1c_client` в каталоге `tools`.

	Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
		"Мсп.Транспорт.SessionRegister",
		"host_id=[" + HostID + "] tools=[" + Строка(Инструменты.Количество()) + "]");

	Сообщение = Новый Структура;
	Сообщение.Вставить("jsonrpc", "2.0");
	Сообщение.Вставить("id",      "reg-1");
	Сообщение.Вставить("method",  "session.register");
	Сообщение.Вставить("params",  ПараметрыРегистрации);

	Попытка
		Отправлено = ОтправитьСообщение(Сообщение);
	Исключение
		Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
			"Мсп.Транспорт.SessionRegister",
			"send ERR: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
		"Мсп.Транспорт.SessionRegister",
		"sent=" + Строка(Отправлено));
	Если Отправлено Тогда
		Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("Зарегистрирован", Истина);
		Мсп_ЛогированиеКлиент.Информация(
			"WS-сессия зарегистрирована: uid=%1 kind=%2 host=%3 tools=%4",
			ClientUID, Kind, HostID, Инструменты.Количество());
	КонецЕсли;
КонецПроцедуры

Асинх Процедура ОбработатьВходящееСообщение(Данные)
	СтрокаДанных = ?(Данные = Неопределено, "", Строка(Данные));
	Если Не ЗначениеЗаполнено(СтрокаДанных) Тогда
		Возврат;
	КонецЕсли;

	Сообщение = Мсп_СериализацияКлиент.ПрочитатьJSONСтрокуБезОшибок(СтрокаДанных, Неопределено);
	Если ТипЗнч(Сообщение) = Тип("Соответствие") Тогда
		Сообщение = СоответствиеВСтруктуру(Сообщение);
	КонецЕсли;
	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Мсп_ЛогированиеКлиент.Важно("WS_INCOMING: не JSON-объект, проигнорировано");
		Возврат;
	КонецЕсли;

	Метод = Мсп_Коллекции.Свойство(Сообщение, "method", "");
	Идентификатор = Мсп_Коллекции.Свойство(Сообщение, "id", "");

	// Ответ на наш собственный запрос (например, ack от менеджера на session.register) - игнорируем.
	Если Не ЗначениеЗаполнено(Метод) Тогда
		Мсп_ЛогированиеКлиент.Отладка("WS_INCOMING: ответ менеджера id=%1, без method", Идентификатор);
		Возврат;
	КонецЕсли;

	Параметры = Мсп_Коллекции.Свойство(Сообщение, "params", Новый Структура);

	// Wire-protocol manager -> client (см. v8-client-session-manager/protocol.rs methods).
	Если Метод = "tool.call" Тогда
		ВыполнитьToolCall(Идентификатор, Параметры);
	ИначеЕсли Метод = "tool.cancel" Тогда
		ВыполнитьToolCancel(Параметры);
	ИначеЕсли Метод = "ping" Тогда
		Ждать Мсп_СерверОтветы.Отправить(
			Идентификатор,
			Новый Структура("jsonrpc, id, result", "2.0", Идентификатор, Новый Структура));
	ИначеЕсли Метод = "session.shutdown" Тогда
		ВыполнитьSessionShutdown(Идентификатор, Параметры);
	Иначе
		Мсп_ЛогированиеКлиент.Важно("WS_INCOMING: неизвестный метод %1", Метод);
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Ждать Мсп_СерверОтветы.Отправить(
				Идентификатор,
				ОтветМетодНеНайден(Идентификатор, Метод));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Обрабатывает manager -> client tool.call.
// Wire-shape запроса: {name, arguments}; ответ: ToolCallResult {content, is_error?, structured_content?}.
Асинх Процедура ВыполнитьToolCall(Идентификатор, Параметры)
	Имя = Мсп_Коллекции.Свойство(Параметры, "name", "");
	Аргументы = Мсп_Коллекции.Свойство(Параметры, "arguments", Новый Структура);
	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Аргументы = Новый Структура;
	КонецЕсли;

	Попытка
		ВызовИнструмента = Мсп_ПротоколКлиент.НовыйВызовИнструмента(
			Идентификатор, Имя, Аргументы, "", "sync", "", Неопределено);
	Исключение
		Ждать Мсп_СерверОтветы.Отправить(Идентификатор, Мсп_ПротоколКлиент.ОшибкаПараметров(Идентификатор));
		Возврат;
	КонецПопытки;

	ОтветПротокола = Мсп_ПротоколКлиент.ВызватьИнструмент(ВызовИнструмента);
	Если ОтветПротокола = Неопределено Тогда
		// Manager-режим не использует deferred/task - но протокольный слой может вернуть Неопределено
		// при некорректной валидации. Шлём Internal error, чтобы менеджер не висел.
		Ждать Мсп_СерверОтветы.Отправить(
			Идентификатор,
			Мсп_ПротоколКлиент.ВнутренняяОшибка(Идентификатор, "Tool execution returned no response"));
		Возврат;
	КонецЕсли;

	Ждать Мсп_СерверОтветы.Отправить(Идентификатор, ПодготовитьОтветToolCall(ОтветПротокола));
КонецПроцедуры

Процедура ВыполнитьToolCancel(Параметры)
	ИдентификаторВызова = Мсп_Коллекции.Свойство(Параметры, "id", "");
	Причина = Мсп_Коллекции.Свойство(Параметры, "reason", "");
	Мсп_ЛогированиеКлиент.Информация("tool.cancel id=%1 reason=%2", ИдентификаторВызова, Причина);
	// На текущем этапе client-side не отслеживает in-flight tool.call'ы - попытка отменить
	// игнорируется. Когда появится task-based execution через WS, добавим Мсп_ЗадачиКлиент.
КонецПроцедуры

Асинх Процедура ВыполнитьSessionShutdown(Идентификатор, Параметры)
	Причина = Мсп_Коллекции.Свойство(Параметры, "reason", "manager_shutdown");
	Мсп_ЛогированиеКлиент.Важно("session.shutdown reason=%1", Причина);

	// Подтверждаем shutdown менеджеру (пустой result).
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Ждать Мсп_СерверОтветы.Отправить(
			Идентификатор,
			Новый Структура("jsonrpc, id, result", "2.0", Идентификатор, Новый Структура));
	КонецЕсли;

	// Шлём session.bye как notification (без id) - менеджер закроет соединение со своей стороны.
	Bye = Новый Структура;
	Bye.Вставить("jsonrpc", "2.0");
	Bye.Вставить("method",  "session.bye");
	Bye.Вставить("params",  Новый Структура("reason", Причина));
	ОтправитьСообщение(Bye);

	// Закрываем тонкий клиент — менеджер запросил shutdown, и нет смысла оставлять
	// процесс висящим. ЗапроситьПодтверждение=Ложь, чтобы не показывать диалог
	// «Закрыть программу?» — кнопку нажимать некому.
	ЗавершитьРаботуСистемы(Ложь, Ложь);
КонецПроцедуры

// Преобразует JSON-RPC ответ Мсп_ПротоколКлиент.ВызватьИнструмент в формат tool.call response,
// ожидаемый менеджером (ToolCallResult со snake_case).
Функция ПодготовитьОтветToolCall(ОтветПротокола)
	// На входе: {jsonrpc, id, result: {content: [...]}} или {jsonrpc, id, error: {code, message}}.
	// Если протокольный слой вернул error - пробрасываем JSON-RPC error как есть (manager обработает).
	Если ОтветПротокола.Свойство("error") Тогда
		Возврат ОтветПротокола;
	КонецЕсли;

	Результат = Мсп_Коллекции.Свойство(ОтветПротокола, "result", Неопределено);
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат ОтветПротокола;
	КонецЕсли;

	// content уже совпадает по shape (Vec<ToolContent> с tag=type, snake_case).
	// Для structuredContent (camelCase) -> переименовываем в structured_content (snake_case).
	ToolCallResult = Новый Структура;
	Если Результат.Свойство("content") Тогда
		ToolCallResult.Вставить("content", Результат.content);
	Иначе
		ToolCallResult.Вставить("content", Новый Массив);
	КонецЕсли;
	Если Результат.Свойство("structuredContent") Тогда
		ToolCallResult.Вставить("structured_content", Результат.structuredContent);
	КонецЕсли;
	Если Результат.Свойство("isError") И Результат.isError = Истина Тогда
		ToolCallResult.Вставить("is_error", Истина);
	КонецЕсли;

	Возврат Новый Структура("jsonrpc, id, result", "2.0", ОтветПротокола.id, ToolCallResult);
КонецФункции

// ADR-0003 / ADR-0005: spawn/kill — обычные MCP-tools прикладного расширения
// test_client (`system_spawn_1c_client`, `system_kill_pid`). Менеджер вызывает
// их через `tools/call`, маршрутизация — по имени tool в каталоге сессии.
// Прежний путь `addin.spawn` / `addin.kill` через web-transport-addin
// (`system_capability.rs`) удалён в этапе В.

Функция ОтветМетодНеНайден(Идентификатор, Метод)
	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("error", Новый Структура("code, message", -32601, "Method not found: " + Метод));
	Возврат Ответ;
КонецФункции

// Собирает Массив wire-дескрипторов инструментов (snake_case) из Мсп_РеестрКлиент.
// Используется в session.register и session.tools_changed.
//
// Возвращаемое значение:
//  Массив, Неопределено - массив дескрипторов; Неопределено при ошибке сборки.
Функция СобратьWireИнструменты()
	Инструменты = Новый Массив;
	Попытка
		Для Каждого Элемент Из Мсп_РеестрКлиент.РеестрИнструментов(Истина) Цикл
			Дескриптор = Элемент.Значение;
			WireДескриптор = Новый Структура;
			WireДескриптор.Вставить("name", Дескриптор.Имя);
			Если ЗначениеЗаполнено(Дескриптор.Описание) Тогда
				WireДескриптор.Вставить("description", Дескриптор.Описание);
			КонецЕсли;
			WireДескриптор.Вставить("input_schema", Дескриптор.СхемаПараметров);
			Инструменты.Добавить(WireДескриптор);
		КонецЦикла;
	Исключение
		Мсп_МетаданныеСервер.ЗаписатьСобытиеВЖР(
			"Мсп.Транспорт.WireTools",
			"build ERR: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
	Возврат Инструменты;
КонецФункции

// Отправляет JSON-RPC notification (без id) менеджеру.
//
// Параметры:
//  Метод - Строка - имя метода.
//  Параметры - Структура, Неопределено - params (опционально).
//
// Возвращаемое значение:
//  Булево - Истина, если notification отправлен.
Функция ОтправитьNotification(Метод, Параметры = Неопределено)
	Сообщение = Новый Структура;
	Сообщение.Вставить("jsonrpc", "2.0");
	Сообщение.Вставить("method", Метод);
	Если Параметры <> Неопределено Тогда
		Сообщение.Вставить("params", Параметры);
	КонецЕсли;
	Возврат ОтправитьСообщение(Сообщение);
КонецФункции

// Истина, если session.register уже отправлен (соединение в режиме "registered").
Функция Зарегистрирован()
	Возврат Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("Зарегистрирован", Ложь);
КонецФункции

// На некоторых конфигурациях ПрочитатьJSON(..., Истина) возвращает Соответствие вместо Структуры.
// Преобразуем в Структуру для совместимости с downstream-кодом, ожидающим Структуру.
Функция СоответствиеВСтруктуру(Соответствие)
	Структура = Новый Структура;
	Для Каждого КЗ Из Соответствие Цикл
		Ключ = Строка(КЗ.Ключ);
		Если ЗначениеЗаполнено(Ключ) Тогда
			Структура.Вставить(Ключ, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Структура;
КонецФункции

#КонецОбласти
