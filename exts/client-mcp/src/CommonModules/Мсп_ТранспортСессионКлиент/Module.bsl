#Область ПрограммныйИнтерфейс

// Запускает WS-клиента к session-manager.
//
// Подключает внешнюю компоненту WebTransport (класс session), сохраняет состояние,
// инициирует соединение. Подключение происходит асинхронно — успех подтверждается
// событием WS_RECONNECT_STATE = "connected", которое обрабатывает ОбработатьВнешнееСобытие.
//
// Параметры:
//  ManagerURL  - Строка - URL session-manager (ws://host:port/path).
//  ClientUID   - Строка - стабильный идентификатор клиента.
//  Kind        - Строка - имя клиента в namespace менеджера.
//  CorrID      - Строка - correlation_id для логов менеджера, может быть пустым.
//
// Возвращаемое значение:
//  Булево - Истина, если компонента подключена и интеграция запущена.
//          Истина не означает "соединение установлено" — это асинхронный процесс.
Асинх Функция Запустить(ManagerURL, ClientUID, Kind, CorrID = "") Экспорт
	Мсп_ЛогированиеКлиент.Информация(
		"WS-транспорт: запуск manager=%1 uid=%2 kind=%3",
		ManagerURL, ClientUID, Kind);

	// Attach компоненты с install fallback.
	Попытка
		Подключено = Ждать ПодключитьКомпоненту();
	Исключение
		Мсп_ЛогированиеКлиент.Ошибка(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;
	Если Не Подключено Тогда
		Мсп_ЛогированиеКлиент.Ошибка("WS-транспорт: не удалось подключить AddIn.WebTransport");
		Возврат Ложь;
	КонецЕсли;

	// Создаём session-инстанс (WS-клиент).
	Попытка
		Компонента = Новый("AddIn.WebTransport.session");
	Исключение
		Мсп_ЛогированиеКлиент.Ошибка(
			"WS-транспорт: ошибка создания AddIn.WebTransport.session: %1",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	// Записываем состояние ДО старта соединения, чтобы обработчик WS_RECONNECT_STATE
	// застал валидную компоненту в момент первого "connecting".
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("Компонента", Компонента);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("РежимТранспорта", "ws");
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("ManagerURL", ManagerURL);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("ClientUID", ClientUID);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("Kind", Kind);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("Зарегистрирован", Ложь);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("WSСостояние", "");

	Попытка
		Запущено = Компонента.ЗапуститьСессионнуюИнтеграцию(ManagerURL, ClientUID, Kind, CorrID);
		Мсп_ЛогированиеКлиент.Информация(
			"WS-транспорт: интеграция запущена manager=%1 uid=%2 kind=%3 ok=%4",
			ManagerURL, ClientUID, Kind, Запущено);
	Исключение
		Мсп_ЛогированиеКлиент.Ошибка(
			"WS-транспорт: ошибка ЗапуститьСессионнуюИнтеграцию: %1",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;
КонецФункции

// Ожидает достижения состояния "connected" с таймаутом.
// Используется dual-mode startup'ом для решения «WS работает / падаем на HTTP fallback».
//
// Параметры:
//  ТаймаутМс - Число - максимальное время ожидания в миллисекундах.
//
// Возвращаемое значение:
//  Булево - Истина, если состояние стало "connected" в течение таймаута.
Асинх Функция ДождатьсяConnected(ТаймаутМс) Экспорт
	ИнтервалОпросаСек = 0.02; // 20 мс
	ИтерацийМакс = Цел(ТаймаутМс / 20) + 1;
	Для Шаг = 1 По ИтерацийМакс Цикл
		Состояние = Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("WSСостояние", "");
		Если Состояние = "connected" Тогда
			Возврат Истина;
		КонецЕсли;
		Если Состояние = "give_up" Тогда
			Возврат Ложь;
		КонецЕсли;
		Ждать ПриостановитьВыполнение(ИнтервалОпросаСек);
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Обрабатывает события addin'а WebTransport в режиме session.
//
// Параметры:
//  Источник - Строка - имя источника ("WebTransport").
//  Событие  - Строка - WS_RECONNECT_STATE | WS_INCOMING.
//  Данные   - Строка - payload события.
//
// Возвращаемое значение:
//  Булево - Истина, если событие распознано и обработано.
Асинх Функция ОбработатьВнешнееСобытие(Источник, Событие, Данные) Экспорт
	Если Источник <> "WebTransport" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Событие = "WS_RECONNECT_STATE" Тогда
		Ждать ОбработатьСменуСостояния(Данные);
		Возврат Истина;
	ИначеЕсли Событие = "WS_INCOMING" Тогда
		Ждать ОбработатьВходящееСообщение(Данные);
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;
КонецФункции

// Отправляет JSON-RPC сообщение менеджеру через WS.
// Используется фасадом Мсп_СерверОтветы для ответов протокольного слоя
// и напрямую при отправке session.register / notifications.
//
// Параметры:
//  Сообщение - Структура - готовая JSON-RPC структура (jsonrpc, id, method/result/error, params).
//
// Возвращаемое значение:
//  Булево - Истина, если компонента приняла сообщение.
Функция ОтправитьСообщение(Сообщение) Экспорт
	Компонента = Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("Компонента", Неопределено);
	Если Компонента = Неопределено Тогда
		Мсп_ЛогированиеКлиент.Важно("WS-транспорт: ОтправитьСообщение пропущено — компонента не подключена");
		Возврат Ложь;
	КонецЕсли;

	ТекстСообщения = Мсп_СериализацияКлиент.Сериализовать(Сообщение);
	Попытка
		Отправлено = Компонента.ОтправитьСообщение(ТекстСообщения);
	Исключение
		Мсп_ЛогированиеКлиент.Ошибка(
			"WS-транспорт: ошибка ОтправитьСообщение: %1",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Если Не Отправлено Тогда
		Мсп_ЛогированиеКлиент.Важно("WS-транспорт: компонента вернула Ложь при ОтправитьСообщение");
	КонецЕсли;
	Возврат Отправлено;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Асинх Функция ПодключитьКомпоненту()
	ИмяМакета = "ОбщийМакет.Мсп_webTransport";
	ИмяКомпоненты = "WebTransport";

	Подключено = Ждать ПодключитьВнешнююКомпонентуАсинх(ИмяМакета, ИмяКомпоненты, ТипВнешнейКомпоненты.Native);
	Если Не Подключено Тогда
		Мсп_ЛогированиеКлиент.Информация("WS-транспорт: установка компоненты из макета");
		Ждать УстановитьВнешнююКомпонентуАсинх(ИмяМакета);
		Подключено = Ждать ПодключитьВнешнююКомпонентуАсинх(ИмяМакета, ИмяКомпоненты, ТипВнешнейКомпоненты.Native);
	КонецЕсли;

	Возврат Подключено;
КонецФункции

Асинх Процедура ОбработатьСменуСостояния(Данные)
	СтрокаДанных = СокрЛП(?(Данные = Неопределено, "", Строка(Данные)));
	Состояние = "";

	Если СтрНачинаетсяС(СтрокаДанных, "{") Тогда
		Разобрано = Мсп_СериализацияКлиент.ПрочитатьJSONСтрокуБезОшибок(СтрокаДанных, Неопределено);
		Если ТипЗнч(Разобрано) = Тип("Структура") И Разобрано.Свойство("state") Тогда
			Состояние = Разобрано.state;
		КонецЕсли;
	Иначе
		Состояние = СтрокаДанных;
	КонецЕсли;

	Мсп_ЛогированиеКлиент.Информация("WS-состояние: %1", Состояние);
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("WSСостояние", Состояние);

	Если Состояние = "connected" Тогда
		Если Не Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("Зарегистрирован", Ложь) Тогда
			Ждать ОтправитьSessionRegister();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Асинх Процедура ОтправитьSessionRegister()
	ClientUID = Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("ClientUID", "");
	Kind      = Мсп_СостояниеКлиент.ЗначениеСостоянияСервера("Kind", "");

	// session.register tools идёт в wire-формате менеджера: snake_case
	// (см. ToolDescriptor в v8-client-session-manager/protocol.rs).
	Инструменты = Новый Массив;
	Для Каждого Элемент Из Мсп_РеестрКлиент.РеестрИнструментов(Истина) Цикл
		Дескриптор = Элемент.Значение;
		WireДескриптор = Новый Структура;
		WireДескриптор.Вставить("name",         Дескриптор.Имя);
		Если ЗначениеЗаполнено(Дескриптор.Описание) Тогда
			WireДескриптор.Вставить("description", Дескриптор.Описание);
		КонецЕсли;
		WireДескриптор.Вставить("input_schema", Дескриптор.СхемаПараметров);
		Инструменты.Добавить(WireДескриптор);
	КонецЦикла;

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("client_uid", ClientUID);
	ПараметрыРегистрации.Вставить("kind",       Kind);
	ПараметрыРегистрации.Вставить("version",    "1.0");
	ПараметрыРегистрации.Вставить("tools",      Инструменты);

	Сообщение = Новый Структура;
	Сообщение.Вставить("jsonrpc", "2.0");
	Сообщение.Вставить("id",      "reg-1");
	Сообщение.Вставить("method",  "session.register");
	Сообщение.Вставить("params",  ПараметрыРегистрации);

	Отправлено = ОтправитьСообщение(Сообщение);
	Если Отправлено Тогда
		Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера("Зарегистрирован", Истина);
		Мсп_ЛогированиеКлиент.Информация(
			"session.register отправлен uid=%1 kind=%2 tools=%3",
			ClientUID, Kind, Инструменты.Количество());
	КонецЕсли;
КонецПроцедуры

Асинх Процедура ОбработатьВходящееСообщение(Данные)
	СтрокаДанных = ?(Данные = Неопределено, "", Строка(Данные));
	Если Не ЗначениеЗаполнено(СтрокаДанных) Тогда
		Возврат;
	КонецЕсли;

	Сообщение = Мсп_СериализацияКлиент.ПрочитатьJSONСтрокуБезОшибок(СтрокаДанных, Неопределено);
	Если ТипЗнч(Сообщение) <> Тип("Структура") Тогда
		Мсп_ЛогированиеКлиент.Важно("WS_INCOMING: не JSON-объект, проигнорировано");
		Возврат;
	КонецЕсли;

	Метод = Мсп_Коллекции.Свойство(Сообщение, "method", "");
	Идентификатор = Мсп_Коллекции.Свойство(Сообщение, "id", "");

	// Ответ на наш собственный запрос (например, ack от менеджера на session.register) — игнорируем.
	Если Не ЗначениеЗаполнено(Метод) Тогда
		Мсп_ЛогированиеКлиент.Отладка("WS_INCOMING: ответ менеджера id=%1, без method", Идентификатор);
		Возврат;
	КонецЕсли;

	Параметры = Мсп_Коллекции.Свойство(Сообщение, "params", Новый Структура);

	// Wire-protocol manager → client (см. v8-client-session-manager/protocol.rs methods).
	Если Метод = "tool.call" Тогда
		Ждать ВыполнитьToolCall(Идентификатор, Параметры);
	ИначеЕсли Метод = "tool.cancel" Тогда
		ВыполнитьToolCancel(Параметры);
	ИначеЕсли Метод = "ping" Тогда
		Ждать Мсп_СерверОтветы.Отправить(
			Идентификатор,
			Новый Структура("jsonrpc, id, result", "2.0", Идентификатор, Новый Структура));
	ИначеЕсли Метод = "session.shutdown" Тогда
		Ждать ВыполнитьSessionShutdown(Идентификатор, Параметры);
	Иначе
		Мсп_ЛогированиеКлиент.Важно("WS_INCOMING: неизвестный метод %1", Метод);
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Ждать Мсп_СерверОтветы.Отправить(
				Идентификатор,
				ОтветМетодНеНайден(Идентификатор, Метод));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Обрабатывает manager → client tool.call.
// Wire-shape запроса: {name, arguments}; ответ: ToolCallResult {content, is_error?, structured_content?}.
Асинх Процедура ВыполнитьToolCall(Идентификатор, Параметры)
	Имя = Мсп_Коллекции.Свойство(Параметры, "name", "");
	Аргументы = Мсп_Коллекции.Свойство(Параметры, "arguments", Новый Структура);
	Если ТипЗнч(Аргументы) <> Тип("Структура") Тогда
		Аргументы = Новый Структура;
	КонецЕсли;

	Попытка
		ВызовИнструмента = Мсп_ПротоколКлиент.НовыйВызовИнструмента(
			Идентификатор, Имя, Аргументы, "", "sync", "", Неопределено);
	Исключение
		Ждать Мсп_СерверОтветы.Отправить(Идентификатор, Мсп_ПротоколКлиент.ОшибкаПараметров(Идентификатор));
		Возврат;
	КонецПопытки;

	ОтветПротокола = Мсп_ПротоколКлиент.ВызватьИнструмент(ВызовИнструмента);
	Если ОтветПротокола = Неопределено Тогда
		// Manager-режим не использует deferred/task — но протокольный слой может вернуть Неопределено
		// при некорректной валидации. Шлём Internal error, чтобы менеджер не висел.
		Ждать Мсп_СерверОтветы.Отправить(
			Идентификатор,
			Мсп_ПротоколКлиент.ВнутренняяОшибка(Идентификатор, "Tool execution returned no response"));
		Возврат;
	КонецЕсли;

	Ждать Мсп_СерверОтветы.Отправить(Идентификатор, ПодготовитьОтветToolCall(ОтветПротокола));
КонецПроцедуры

Процедура ВыполнитьToolCancel(Параметры)
	ИдентификаторВызова = Мсп_Коллекции.Свойство(Параметры, "id", "");
	Причина = Мсп_Коллекции.Свойство(Параметры, "reason", "");
	Мсп_ЛогированиеКлиент.Информация("tool.cancel id=%1 reason=%2", ИдентификаторВызова, Причина);
	// На текущем этапе client-side не отслеживает in-flight tool.call'ы — попытка отменить
	// игнорируется. Когда появится task-based execution через WS, добавим Мсп_ЗадачиКлиент.
КонецПроцедуры

Асинх Процедура ВыполнитьSessionShutdown(Идентификатор, Параметры)
	Причина = Мсп_Коллекции.Свойство(Параметры, "reason", "manager_shutdown");
	Мсп_ЛогированиеКлиент.Важно("session.shutdown reason=%1", Причина);

	// Подтверждаем shutdown менеджеру (пустой result).
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Ждать Мсп_СерверОтветы.Отправить(
			Идентификатор,
			Новый Структура("jsonrpc, id, result", "2.0", Идентификатор, Новый Структура));
	КонецЕсли;

	// Шлём session.bye как notification (без id) — менеджер закроет соединение со своей стороны.
	Bye = Новый Структура;
	Bye.Вставить("jsonrpc", "2.0");
	Bye.Вставить("method",  "session.bye");
	Bye.Вставить("params",  Новый Структура("reason", Причина));
	ОтправитьСообщение(Bye);
КонецПроцедуры

// Преобразует JSON-RPC ответ Мсп_ПротоколКлиент.ВызватьИнструмент в формат tool.call response,
// ожидаемый менеджером (ToolCallResult со snake_case).
Функция ПодготовитьОтветToolCall(ОтветПротокола)
	// На входе: {jsonrpc, id, result: {content: [...]}} или {jsonrpc, id, error: {code, message}}.
	// Если протокольный слой вернул error — пробрасываем JSON-RPC error как есть (manager обработает).
	Если ОтветПротокола.Свойство("error") Тогда
		Возврат ОтветПротокола;
	КонецЕсли;

	Результат = Мсп_Коллекции.Свойство(ОтветПротокола, "result", Неопределено);
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат ОтветПротокола;
	КонецЕсли;

	// content уже совпадает по shape (Vec<ToolContent> с tag=type, snake_case).
	// Для structuredContent (camelCase) → переименовываем в structured_content (snake_case).
	ToolCallResult = Новый Структура;
	Если Результат.Свойство("content") Тогда
		ToolCallResult.Вставить("content", Результат.content);
	Иначе
		ToolCallResult.Вставить("content", Новый Массив);
	КонецЕсли;
	Если Результат.Свойство("structuredContent") Тогда
		ToolCallResult.Вставить("structured_content", Результат.structuredContent);
	КонецЕсли;
	Если Результат.Свойство("isError") И Результат.isError = Истина Тогда
		ToolCallResult.Вставить("is_error", Истина);
	КонецЕсли;

	Возврат Новый Структура("jsonrpc, id, result", "2.0", ОтветПротокола.id, ToolCallResult);
КонецФункции

Функция ОтветМетодНеНайден(Идентификатор, Метод)
	Ответ = Новый Структура;
	Ответ.Вставить("jsonrpc", "2.0");
	Ответ.Вставить("id", Идентификатор);
	Ответ.Вставить("error", Новый Структура("code, message", -32601, "Method not found: " + Метод));
	Возврат Ответ;
КонецФункции

#КонецОбласти
