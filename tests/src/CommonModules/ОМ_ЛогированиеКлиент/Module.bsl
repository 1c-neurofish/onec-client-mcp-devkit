#Область ПрограммныйИнтерфейс

// Регистрирует сценарии тестового модуля.
Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		.ДобавитьТест("УстановитьПараметрыЛогированияСохраняетЗначения")
		.ДобавитьТест("УстановитьПараметрыЛогированияБезУровняНеМеняетУровень")
		.ДобавитьТест("ДиагностическоеПредставлениеJSONСериализуетСтруктуру")
		.ДобавитьТест("ДиагностическоеПредставлениеJSONВозвращаетМаркерОшибки")
		.ДобавитьТест("ОтладкаПишетКириллицуИJSONВUTF8Файл")
		.ДобавитьТест("ОтладкаПишетISOВремяБезЛокальныхСлешей")
	;
КонецПроцедуры

// Проверяет, что УстановитьПараметрыЛогирования сохраняет все три поля.
Процедура УстановитьПараметрыЛогированияСохраняетЗначения() Экспорт
	ПодготовитьСостояние();

	Мсп_ЛогированиеКлиент.УстановитьПараметрыЛогирования(Истина, "/tmp/test.log", "warn");

	ЮТест.ОжидаетЧто(Мсп_ЛогированиеКлиент.ПараметрыЛогирования())
		.Свойство("Логировать").ЭтоИстина()
		.Свойство("ФайлЛога").Равно("/tmp/test.log")
		.Свойство("УровеньЛога").Равно("warn")
	;
КонецПроцедуры

// Проверяет, что УстановитьПараметрыЛогирования без уровня не меняет текущий уровень.
Процедура УстановитьПараметрыЛогированияБезУровняНеМеняетУровень() Экспорт
	ПодготовитьСостояние();
	Мсп_ЛогированиеКлиент.УстановитьПараметрыЛогирования(Истина, "", "error");
	Мсп_ЛогированиеКлиент.УстановитьПараметрыЛогирования(Ложь, "");

	ЮТест.ОжидаетЧто(Мсп_ЛогированиеКлиент.ПараметрыЛогирования())
		.Свойство("Логировать").ЭтоЛожь()
		.Свойство("УровеньЛога").Равно("error")
	;
КонецПроцедуры

// Проверяет JSON-представление структурированных диагностических данных.
Процедура ДиагностическоеПредставлениеJSONСериализуетСтруктуру() Экспорт
	Данные = Новый Структура("tool,message", "find", "Привет");

	Представление = Мсп_ЛогированиеКлиент.ДиагностическоеПредставлениеJSON(Данные);

	ЮТест.ОжидаетЧто(СтрНайти(Представление, """tool"": ""find""") > 0).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(Представление, """message"": ""Привет""") > 0).ЭтоИстина();
КонецПроцедуры

// Проверяет, что ошибка сериализации остается диагностикой и не прерывает вызов.
Процедура ДиагностическоеПредставлениеJSONВозвращаетМаркерОшибки() Экспорт
	Представление = Мсп_ЛогированиеКлиент.ДиагностическоеПредставлениеJSON(Новый ОписаниеОповещения());

	ЮТест.ОжидаетЧто(СтрНайти(Представление, "<serialization-error:") = 1).ЭтоИстина();
КонецПроцедуры

// Проверяет, что файл лога остается читаемым UTF-8 текстом с кириллицей и JSON.
Процедура ОтладкаПишетКириллицуИJSONВUTF8Файл() Экспорт
	ИмяФайлаЛога = ЮТТестовыеДанные.НовоеИмяВременногоФайла("log");
	ЮТФайлы.ЗаписатьТекстВФайла(ИмяФайлаЛога, "");
	ПодготовитьСостояние();
	Мсп_ЛогированиеКлиент.УстановитьПараметрыЛогирования(Истина, ИмяФайлаЛога, "debug");

	Данные = Новый Структура("message", "Привет");
	Мсп_ЛогированиеКлиент.Отладка(
		"payload=%1",
		Мсп_ЛогированиеКлиент.ДиагностическоеПредставлениеJSON(Данные));

	Мсп_ЛогированиеКлиент.УстановитьПараметрыЛогирования(Ложь, "", "error");
	ТекстЛога = ЮТФайлы.ДанныеТекстовогоФайла(ИмяФайлаЛога);

	ЮТест.ОжидаетЧто(СтрНайти(ТекстЛога, """message"": ""Привет""") > 0).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(ТекстЛога, "payload=") > 0).ЭтоИстина();
КонецПроцедуры

// Проверяет, что timestamp не деградирует в локальный формат 5/24/2026 11:.. PM.
Процедура ОтладкаПишетISOВремяБезЛокальныхСлешей() Экспорт
	ИмяФайлаЛога = ЮТТестовыеДанные.НовоеИмяВременногоФайла("log");
	ЮТФайлы.ЗаписатьТекстВФайла(ИмяФайлаЛога, "");
	ПодготовитьСостояние();
	Мсп_ЛогированиеКлиент.УстановитьПараметрыЛогирования(Истина, ИмяФайлаЛога, "debug");

	Мсп_ЛогированиеКлиент.Отладка("timestamp-check");

	Мсп_ЛогированиеКлиент.УстановитьПараметрыЛогирования(Ложь, "", "error");
	ТекстЛога = ЮТФайлы.ДанныеТекстовогоФайла(ИмяФайлаЛога);
	ПозицияНачала = СтрНайти(ТекстЛога, "[MCP DEBUG ");
	ПозицияСообщения = СтрНайти(ТекстЛога, "] timestamp-check");
	Заголовок = Сред(ТекстЛога, ПозицияНачала, ПозицияСообщения - ПозицияНачала);

	ЮТест.ОжидаетЧто(ПозицияНачала > 0).ЭтоИстина();
	ЮТест.ОжидаетЧто(ПозицияСообщения > ПозицияНачала).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(Заголовок, "/") = 0).ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрНайти(Заголовок, "-") > 0).ЭтоИстина();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьСостояние()
	Мсп_СостояниеКлиент.УстановитьЗначениеСостоянияСервера(
		"ПараметрыЛогирования",
		Новый Структура("Логировать,УровеньЛога,ФайлЛога", Ложь, "error", ""));
КонецПроцедуры

#КонецОбласти
